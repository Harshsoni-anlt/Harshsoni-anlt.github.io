---
// Capabilities as a calm, precise selector: a list on the left, the proof on the right.
// Replaces the floating constellation (Harsh: "glitchy"). Without JS every panel is shown in sequence.
import { CAPABILITIES } from '../data/capabilities'
---
<section id="capabilities" class="wrap caps" aria-labelledby="cap-h">
  <div class="head" data-reveal>
    <p class="eyebrow">What I can do for you</p>
    <h2 id="cap-h">Seven ways I make AI pay for itself</h2>
    <p class="intro">Each starts with the problem the way a business usually puts it. Pick one to see the proof.</p>
  </div>

  <div class="grid">
    <ol class="list" role="tablist" aria-label="Capabilities" aria-orientation="vertical">
      {CAPABILITIES.map((c, i) => (
        <li>
          <button type="button" role="tab" id={`cap-t-${c.id}`} aria-controls={`cap-p-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-cap={c.id} class={i === 0 ? 'on' : undefined}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{c.name}</span>
          </button>
        </li>
      ))}
    </ol>

    <div class="panels">
      {CAPABILITIES.map((c, i) => (
        <article role="tabpanel" id={`cap-p-${c.id}`} aria-labelledby={`cap-t-${c.id}`} class={`panel ring ${i === 0 ? 'on' : ''}`} tabindex="0">
          <p class="quote">“{c.problem}”</p>
          <h3>{c.name}</h3>
          <ul class="skills">{c.skills.map(s => <li>{s}</li>)}</ul>
          <p class="eyebrow">Proof</p>
          <ul class="proof">
            {c.proof.map(p => <li>{p.href ? <a href={p.href}>{p.label}<span aria-hidden="true">↗</span></a> : <span>{p.label}</span>}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('#capabilities [role="tab"]')]
  const show = (t: HTMLButtonElement, focus = false) => {
    tabs.forEach(o => {
      const on = o === t
      o.setAttribute('aria-selected', String(on))
      o.tabIndex = on ? 0 : -1
      o.classList.toggle('on', on)
      document.getElementById(o.getAttribute('aria-controls')!)!.classList.toggle('on', on)
    })
    if (focus) t.focus()
  }
  const fine = matchMedia('(pointer: fine)').matches
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => {
      show(t)
      // On a phone the panel sits below the list: bring it into view.
      if (!fine) document.getElementById(t.getAttribute('aria-controls')!)!.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
    })
    // A short hover intent delay: moving the mouse across the list toward the panel doesn't flick through items.
    let hov = 0
    if (fine) {
      t.addEventListener('pointerenter', () => { clearTimeout(hov); hov = window.setTimeout(() => show(t), 110) })
      t.addEventListener('pointerleave', () => clearTimeout(hov))
    }
    t.addEventListener('keydown', e => {
      const k = e.key === 'ArrowDown' ? 1 : e.key === 'ArrowUp' ? -1 : 0
      if (k) { e.preventDefault(); show(tabs[(i + k + tabs.length) % tabs.length]!, true) }
    })
  })
</script>

<style>
  .caps { padding-top: 140px; padding-bottom: 40px; position: relative; z-index: 1; }
  .head { max-width: 760px; margin-bottom: 48px; }
  h2 { font: 700 clamp(2.25rem, 5.5vw, 4.25rem)/1.02 var(--display); letter-spacing: -0.04em; margin: 14px 0 16px; }
  .intro { color: var(--ink-2); font-size: 1.125rem; margin: 0; }
  .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 40px; align-items: start; }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .list li { border-bottom: 1px solid var(--rule); }
  .list button {
    all: unset; box-sizing: border-box; display: grid; grid-template-columns: 44px 1fr; align-items: baseline; gap: 12px; width: 100%;
    padding: 20px 8px 20px 18px; cursor: pointer; position: relative; color: var(--ink-2); transition: color .25s;
  }
  .list button > * { transition: transform .35s cubic-bezier(.2,.7,.2,1); }
  .list button.on > * { transform: translateX(6px); }
  .list button::before { content: ''; position: absolute; left: 0; top: 18px; bottom: 18px; width: 2px; border-radius: 2px; background: var(--chroma); transform: scaleY(0); transition: transform .3s cubic-bezier(.2,.7,.2,1); }
  .list button.on { color: var(--ink); }
  @media (hover: hover) { .list button:hover { color: var(--ink); } }
  .list button.on::before { transform: scaleY(1); }
  .list button:focus-visible { outline: 2px solid var(--c1); outline-offset: 2px; border-radius: 8px; }
  .n { font: 500 .8125rem var(--mono); color: var(--ink-2); }
  .on .n { background: var(--chroma); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .name { font: 600 clamp(1.25rem, 2.2vw, 1.75rem)/1.2 var(--display); letter-spacing: -0.02em; }

  .panels { position: sticky; top: 96px; display: grid; align-self: start; }
  .panel {
    grid-area: 1 / 1; padding: 34px; border-radius: 22px; background: linear-gradient(180deg, var(--surface-2), var(--surface)); border: 1px solid var(--rule);
    opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity .15s, transform .15s, visibility 0s .15s;
  }
  .panel.on { opacity: 1; visibility: visible; transform: none; transition: opacity .3s .1s, transform .35s .1s cubic-bezier(.2,.7,.2,1), visibility 0s; }
  .quote { font: 500 clamp(1.25rem, 2vw, 1.5rem)/1.35 var(--display); margin: 0 0 22px; letter-spacing: -0.01em; }
  .panel h3 { font: 500 .8125rem var(--mono); letter-spacing: .12em; text-transform: uppercase; color: var(--ink-2); margin: 0 0 14px; }
  .skills { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 26px; padding: 0; }
  .skills li { font: 500 .8125rem var(--mono); padding: 6px 12px; border-radius: 999px; border: 1px solid var(--rule); background: var(--bg); }
  .proof { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 2px; }
  .proof a, .proof span { display: flex; justify-content: space-between; gap: 12px; padding: 12px 0; border-top: 1px solid var(--rule); text-decoration: none; font-size: .9875rem; }
  @media (hover: hover) { .proof a:hover { color: var(--c1); } }
  .proof a { min-height: 44px; align-items: center; }
  .proof a span { border: 0; padding: 0; color: var(--ink-2); }

  @media (max-width: 960px) {
    .grid { grid-template-columns: 1fr; gap: 24px; }
    .panels { position: static; display: block; }
    .panel { display: none; }
    .panel.on { display: block; }
    .list button { grid-template-columns: 30px 1fr; padding: 16px 8px 16px 16px; }
    .panel { padding: 24px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .panel, .panel.on, .list button, .list button::before { transition: none; }
  }
</style>

---
// Status is never colour alone: every pill carries its word, and its shape differs too.
interface Props { status: 'production' | 'uat' | 'contributing' | 'shipped' | 'cleared' | 'in-progress' }
const WORDS = { production: 'In production', uat: 'In UAT', contributing: 'Contributing', shipped: 'Shipped', cleared: 'Shipped', 'in-progress': 'In progress' } as const
const { status } = Astro.props
---
<span class={`pill ${status}`}>{WORDS[status]}</span>

<style>
  .pill {
    display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 999px;
    font: 600 .75rem/1 var(--mono); letter-spacing: .02em; white-space: nowrap; border: 1.5px solid currentColor;
  }
  .production { background: var(--ok); color: var(--bg); border-color: var(--ok); }
  .uat { color: var(--uat); border-style: dashed; }
  .shipped, .cleared { color: var(--ink); }
  .contributing, .in-progress { color: var(--ink-2); }
</style>

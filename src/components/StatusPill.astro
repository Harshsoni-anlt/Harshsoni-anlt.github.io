---
// One pill style everywhere: a quiet outline, a status dot, and always the word (status is never colour alone).
interface Props { status: 'production' | 'uat' | 'contributing' | 'shipped' | 'cleared' | 'in-progress' | 'consulting' }
const WORDS = { production: 'In production', uat: 'In UAT', contributing: 'Contributing', shipped: 'Shipped', cleared: 'Shipped', 'in-progress': 'In progress', consulting: 'Consulting' } as const
const { status } = Astro.props
---
<span class={`pill ${status}`}><i aria-hidden="true"></i>{WORDS[status]}</span>

<style>
  .pill {
    display: inline-flex; align-items: center; gap: 8px; height: 26px; padding: 0 12px; border-radius: 999px;
    font: 500 .75rem/1 var(--mono); letter-spacing: .02em; white-space: nowrap; color: var(--ink);
    border: 1px solid var(--rule); background: color-mix(in oklch, var(--bg) 60%, transparent);
  }
  i { width: 6px; height: 6px; border-radius: 50%; background: var(--ink-2); }
  .production i { background: var(--ok); box-shadow: 0 0 10px var(--ok); }
  .uat i { background: var(--uat); }
  .consulting i { background: var(--chroma); }
  .shipped i, .cleared i { background: var(--ink); }
</style>

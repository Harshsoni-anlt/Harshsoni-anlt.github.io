---
// Solution wizard: a command terminal over the same data the pages render from.
// Opens on ⌘K / Ctrl+K, on "/" outside a field, and on click of any [data-open-terminal].
import { getCollection } from 'astro:content'
import { profile } from '../data/profile'
import { sortQuests, sortWork } from '../lib/achievements'

const data = {
  name: profile.name,
  role: profile.role,
  location: profile.location,
  email: profile.email,
  linkedin: profile.linkedin,
  github: profile.github,
  availability: profile.availability.text,
  capabilities: profile.capabilities.map(({ name, detail }) => ({ name, detail })),
  quests: sortQuests(await getCollection('quests')).map((q) => ({ id: q.id, title: q.data.title, status: q.data.status, tagline: q.data.tagline })),
  work: sortWork(await getCollection('work')).map((w) => ({ title: w.data.title, status: w.data.status, chapter: w.data.chapter })),
}
const json = JSON.stringify(data).replace(/</g, '\\u003c')
---
<script type="application/json" id="terminal-data" set:html={json} />

<dialog id="wizard" class="wiz" aria-label="Wizard terminal" data-lenis-prevent>
  <div class="tb">
    <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="ttl">wizard — zsh</span>
    <button type="button" class="x" aria-label="Close terminal">esc</button>
  </div>
  <div class="log" role="log" aria-live="polite"></div>
  <form class="prompt">
    <label for="wiz-in" class="sr">Command</label>
    <span class="ps" aria-hidden="true">harsh@portfolio:~$</span>
    <input id="wiz-in" type="text" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" enterkeyhint="send" />
  </form>
</dialog>

<script>
  type D = {
    name: string; role: string; location: string; email: string; linkedin: string; github: string; availability: string
    capabilities: { name: string; detail: string }[]
    quests: { id: string; title: string; status: string; tagline: string }[]
    work: { title: string; status: string; chapter: string }[]
  }
  type Part = string | [text: string, href: string]

  const dlg = document.getElementById('wizard') as HTMLDialogElement
  const log = dlg.querySelector('.log') as HTMLElement
  const input = dlg.querySelector('input') as HTMLInputElement
  const d: D = JSON.parse(document.getElementById('terminal-data')!.textContent!)
  const PS = 'harsh@portfolio:~$ '
  const mail = 'mailto:' + d.email

  const line = (cls: string, ...parts: Part[]) => {
    const el = document.createElement('div')
    el.className = cls
    for (const p of parts) {
      if (typeof p === 'string') { el.append(p); continue }
      const a = document.createElement('a')
      a.href = p[1]
      a.textContent = p[0]
      if (p[1].startsWith('http')) { a.target = '_blank'; a.rel = 'noopener' }
      el.append(a)
    }
    log.append(el)
    log.scrollTop = log.scrollHeight
  }
  const say = (...parts: Part[]) => line('', ...parts)
  const go = (href: string) => setTimeout(() => (location.href = href), 600)
  const qUrl = (id: string) => `/quests/${id}/`
  const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, '')
  // ponytail: substring then subsequence match; swap for scored fuzzy search if titles start colliding
  const norm = (s: string) => s.toLowerCase().replace(/[\s-]+/g, '')
  const subseq = (s: string, t: string) => { let i = 0; for (const c of t) if (c === s[i]) i++; return i === s.length }

  const contact = () => {
    line('', 'email     ', [d.email, mail])
    navigator.clipboard?.writeText(d.email).then(() => line('ok', '✓ email copied to clipboard'), () => {})
    line('', 'linkedin  ', [bare(d.linkedin), d.linkedin])
    line('', 'github    ', [bare(d.github), d.github])
    line('dim', d.availability)
  }

  const cmds: Record<string, [help: string, run: (arg: string) => void]> = {
    help: ['list commands', () => { for (const [k, [h]] of Object.entries(cmds)) say(k.padEnd(10) + h) }],
    whoami: ['who is this', () => {
      say(`${d.name} · ${d.role} · ${d.location}`)
      say('I take enterprise AI from the client\'s problem to production. Now: Kyndryl, with document AI live at a regulated bank. Before: UPL, demand forecasting across 9 regions and the UPL OpenAg Awards 2024–25. Try: work · projects · hire')
    }],
    skills: ['what I work with', () => {
      line('h', 'Capabilities')
      for (const c of d.capabilities) say(`▸ ${c.name} — ${c.detail}`)
    }],
    projects: ['systems I\'ve shipped', () => {
      line('h', 'Systems')
      for (const q of d.quests) {
        line('', '▸ ', [q.title, qUrl(q.id)], ` [${q.status}]`)
        line('dim', '  ' + q.tagline)
      }
      line('dim', 'open <name> to jump to one')
    }],
    work: ['day-job work at Kyndryl and UPL', () => {
      for (const [ch, label] of [['kyndryl', 'Kyndryl'], ['upl', 'UPL']]) {
        line('h', label)
        for (const w of d.work) if (w.chapter === ch) say(`▸ ${w.title} [${w.status}]`)
      }
    }],
    next: ['the next quest', () => {
      line('h', 'Next quest')
      say('Future-ready AI engineer and leader. Paths I\'m building toward: my own AI product · FDE at a frontier AI lab · independent AI consultant · AI architect / lead.')
    }],
    resume: ['open the résumé', () => { say('Opening ', ['/resume/', '/resume/'], ' …'); go('/resume/') }],
    contact: ['email, LinkedIn, GitHub', contact],
    hire: ['same as contact', contact],
    open: ['<name>  jump to a project', (a) => {
      const s = norm(a)
      if (!s) return say('usage: open <name> — try projects')
      const q = d.quests.find((q) => norm(q.title + q.id).includes(s)) ?? d.quests.find((q) => subseq(s, norm(q.title)))
      if (!q) return say(`no project matches "${a}" — try projects`)
      say('Opening ', [q.title, qUrl(q.id)], ' …')
      go(qUrl(q.id))
    }],
    clear: ['clear the screen', () => log.replaceChildren()],
    exit: ['close the terminal', () => dlg.close()],
  }
  const names = [...Object.keys(cmds), ...d.quests.map((q) => 'open ' + q.id)]

  const hist: string[] = []
  let hi = 0
  const run = (raw: string) => {
    const v = raw.trim()
    line('echo', PS + v)
    if (!v) return
    hi = hist.push(v)
    if (/^sudo\s+hire\s+harsh$/i.test(v)) { say('Permission granted. Opening email…'); go(mail + '?subject=Hiring'); return }
    const [c, ...rest] = v.split(/\s+/)
    const k = c.toLowerCase()
    if (Object.hasOwn(cmds, k)) cmds[k][1](rest.join(' '))
    else say(`command not found: ${c} — try help`)
  }

  let opener: HTMLElement | null = null
  let greeted = false
  const open = (from?: Element | null) => {
    if (dlg.open) return
    opener = (from ?? document.activeElement) as HTMLElement | null
    dlg.showModal()
    if (!greeted) {
      greeted = true
      line('h', 'Solution wizard v1')
      say('type help, or try: projects · skills · hire')
    }
    input.focus()
  }

  dlg.addEventListener('close', () => {
    input.value = ''
    hi = hist.length
    opener?.focus?.()
  })
  dlg.querySelector('form')!.addEventListener('submit', (e) => {
    e.preventDefault()
    run(input.value)
    input.value = ''
  })
  dlg.addEventListener('click', (e) => {
    const t = e.target as Element
    if (t === dlg || t.closest('.x')) dlg.close()
    else if (!t.closest('a,button,input') && getSelection()?.isCollapsed) input.focus()
  })

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp' && hi > 0) { e.preventDefault(); input.value = hist[--hi] }
    else if (e.key === 'ArrowDown' && hi < hist.length) { e.preventDefault(); input.value = hist[++hi] ?? '' }
    else if (e.key === 'Tab' && input.value) {
      // Empty input lets Tab move focus as normal, so keyboard users can still reach the links.
      e.preventDefault()
      const v = input.value.toLowerCase()
      const m = names.filter((n) => n.startsWith(v))
      if (!m.length) return
      let p = m[0]
      for (const n of m) while (!n.startsWith(p)) p = p.slice(0, -1)
      if (m.length > 1 && p.length === v.length) say(m.join('  '))
      input.value = p
    }
  })

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && (e.key ?? '').toLowerCase() === 'k') {
      e.preventDefault()
      dlg.open ? dlg.close() : open()
    } else if (e.key === '/' && !dlg.open) {
      const t = e.target as HTMLElement
      if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return
      e.preventDefault()
      open()
    }
  })
  document.addEventListener('click', (e) => {
    const t = (e.target as Element).closest?.('[data-open-terminal]')
    if (t) { e.preventDefault(); open(t) }
  })
</script>

<style>
  .wiz {
    width: min(720px, calc(100% - 32px)); max-width: none; max-height: min(72vh, 600px);
    margin: 12vh auto auto; padding: 0; overflow: hidden;
    color: var(--ink); font: .875rem/1.55 var(--mono);
    background: color-mix(in oklch, var(--surface) 92%, transparent);
    -webkit-backdrop-filter: blur(16px); backdrop-filter: blur(16px);
    border: 1px solid var(--rule); border-radius: 12px;
    box-shadow: 0 24px 80px rgb(0 0 0 / .35);
  }
  .wiz[open] { display: flex; flex-direction: column; animation: wiz-in 180ms cubic-bezier(.2, .7, .2, 1); }
  .wiz::before { content: ''; flex: none; height: 2px; background: linear-gradient(90deg, var(--kyndryl), var(--upl), var(--oss), var(--frontier)); }
  .wiz::backdrop { background: rgb(5 6 12 / .5); }
  @keyframes wiz-in { from { opacity: 0; transform: scale(.96); } }
  @media (prefers-reduced-motion: reduce) { .wiz[open] { animation: none; } }

  .tb { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-bottom: 1px solid var(--rule); color: var(--ink-2); font-size: .75rem; }
  .dots { display: flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--frontier); }
  .dots i:nth-child(2) { background: var(--upl); }
  .dots i:nth-child(3) { background: var(--ok); }
  .ttl { flex: 1; text-align: center; }
  .x { font: inherit; color: inherit; background: none; border: 1px solid var(--rule); border-radius: 999px; padding: 2px 10px; cursor: pointer; min-height: 28px; }
  .x:hover { color: var(--ink); }

  .log { flex: 1; min-height: 160px; overflow-y: auto; overscroll-behavior: contain; padding: 12px 16px 4px; }
  .log :global(div) { white-space: pre-wrap; overflow-wrap: anywhere; }
  .log :global(.echo), .log :global(.dim) { color: var(--ink-2); }
  .log :global(.echo) { margin-top: .5em; }
  .log :global(.h) { color: var(--frontier); font-weight: 600; margin-top: .4em; }
  .log :global(.ok) { color: var(--ok); }
  .log :global(a) { color: var(--kyndryl); }

  .prompt { display: flex; align-items: center; gap: .6em; padding: 8px 16px 14px; }
  .ps { flex: none; color: var(--kyndryl); }
  .prompt input { flex: 1; min-width: 0; padding: 4px 0; font: inherit; color: var(--ink); caret-color: var(--frontier); background: transparent; border: 0; outline: 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 640px) {
    .wiz { width: 100%; height: 72dvh; max-height: 72dvh; margin: auto 0 0; border-radius: 22px 22px 0 0; border-bottom: 0; }
    .x { min-width: 44px; min-height: 44px; }
    .prompt { padding-bottom: calc(14px + env(safe-area-inset-bottom)); }
    .prompt input { font-size: 16px; }
    .ps { font-size: .75rem; }
  }
</style>

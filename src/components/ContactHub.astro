---
import { profile } from '../data/profile'

interface Props { variant: 'hero' | 'full' | 'bar' }
const { variant } = Astro.props

// Until a phone-free résumé PDF is dropped into public/, the button points at the HTML résumé.
// Vite resolves the glob from the project root, so this holds whatever directory the build runs from.
const hasPdf = Object.keys(import.meta.glob('/public/resume.pdf')).length > 0
const resume = hasPdf
  ? { href: '/resume.pdf', label: `Download résumé · PDF · ${profile.resumeUpdated}`, tile: 'One-page PDF', short: 'Résumé', download: true }
  : { href: '/resume/', label: 'Résumé', tile: 'View the one-page résumé', short: 'Résumé', download: false }
const book = profile.cal.intro
  ? { href: profile.cal.intro, label: 'Hiring? 20-min intro' }
  : { href: `mailto:${profile.email}?subject=Intro%20call`, label: 'Book a call' }
---
{variant === 'hero' && (
  <div class="hub hero">
    <a class="btn primary" href={resume.href} download={resume.download || undefined}>{resume.label}</a>
    <a class="btn" href={book.href}>{book.label}</a>
  </div>
)}

{variant === 'bar' && (
  <>
    <header class="bar top" aria-label="Site">
      <div class="bar-in">
        <a class="name" href="/">{profile.name}</a>
        <nav aria-label="Sections">
          <a href="/#journey">Story</a><a href="/#work">Work</a><a href="/#systems">Systems</a><a href="/log/">Log</a><a href="/#contact">Contact</a>
        </nav>
        <span class="bar-cta">
          <a class="btn sm primary" href={resume.href} download={resume.download || undefined}>{resume.short}</a>
          <a class="btn sm" href={book.href}>Book a call</a>
        </span>
      </div>
    </header>
    <nav class="bar bottom" aria-label="Quick links">
      <a href="/#work">Work</a>
      <a href={resume.href} download={resume.download || undefined}>Résumé</a>
      <a href={`mailto:${profile.email}`}>Email</a>
      <a href={book.href}>Book</a>
    </nav>
  </>
)}

{variant === 'full' && (
  <div class="hub full">
    <a class="tile" href={resume.href} download={resume.download || undefined}>
      <span class="k">Résumé</span><span class="v">{resume.tile}</span>
    </a>
    <a class="tile" href={book.href}>
      <span class="k">Talk</span><span class="v">{book.label}</span>
    </a>
    <div class="tile">
      <span class="k">Email</span>
      <span class="v"><a href={`mailto:${profile.email}`}>{profile.email}</a>
        <button class="copy" type="button" data-copy={profile.email} hidden>Copy</button>
        <span class="copied" aria-live="polite"></span></span>
    </div>
    <div class="tile">
      <span class="k">Elsewhere</span>
      <span class="v links">
        <a href={profile.linkedin}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.06c.53-1 1.84-2.06 3.79-2.06 4.05 0 4.8 2.67 4.8 6.13V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7V21h-4V9.5Z"/></svg>LinkedIn</a>
        <a href={profile.github}><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.24 2.75.12 3.04.73.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>GitHub</a>
      </span>
    </div>
    <p class="avail">{profile.availability.text} · as of {profile.availability.asOf}</p>
  </div>
)}

<style>
  .hub.hero { display: flex; flex-wrap: wrap; gap: 12px; }
  .hub.full { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  @media (max-width: 640px) { .hub.full { grid-template-columns: 1fr; } }
  .tile {
    display: flex; flex-direction: column; gap: 8px; min-height: 48px; padding: 24px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface)); border: 1px solid var(--rule); border-radius: 22px; text-decoration: none; color: var(--ink);
    transition: border-color .25s;
  }
  @media (hover: hover) { a.tile:hover { border-color: color-mix(in oklch, var(--ink) 30%, transparent); } }
  .k { font: 500 .75rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .v { font: 600 1.125rem/1.35 var(--display); overflow-wrap: anywhere; }
  .v a { color: inherit; display: inline-flex; align-items: center; min-height: 44px; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; }
  .links a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
  .links svg { width: 18px; height: 18px; fill: currentColor; }
  .copy { margin-left: 10px; font: 500 .8125rem var(--mono); padding: 0 14px; min-height: 44px; border-radius: 999px; border: 1px solid var(--rule); background: transparent; color: var(--ink); cursor: pointer; vertical-align: middle; }
  .copied { font: 500 .8125rem var(--mono); color: var(--ok); margin-left: 6px; }
  .avail { grid-column: 1 / -1; margin: 4px 0 0; font: .8125rem var(--mono); color: var(--ink-2); }

  .bar { z-index: 20; background: color-mix(in oklch, var(--bg) 88%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); }
  .bar.top { position: sticky; top: 0; height: 56px; border-bottom: 1px solid var(--rule); }
  .bar-in { max-width: 1200px; height: 100%; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; gap: 24px; }
  .bar.top .name { font: 700 1rem/1 var(--display); letter-spacing: -0.02em; text-decoration: none; color: var(--ink); margin-right: auto; display: inline-flex; align-items: center; min-height: 44px; }
  .bar.top nav { display: flex; gap: 22px; }
  .bar.top nav a { font: 500 .875rem var(--body); color: var(--ink-2); text-decoration: none; transition: color .2s; }
  .bar.top nav a:hover { color: var(--ink); }
  .bar-cta { display: flex; gap: 8px; }
  .bar.bottom { display: none; }
  @media (max-width: 1023px) {
    .bar.top nav, .bar-cta { display: none; }
    .bar-in { padding: 0 16px; }
    .bar.bottom {
      display: grid; grid-template-columns: repeat(4, 1fr); position: fixed; left: 0; right: 0; bottom: 0;
      height: calc(56px + env(safe-area-inset-bottom)); padding-bottom: env(safe-area-inset-bottom);
      border-top: 1px solid var(--rule);
    }
    .bar.bottom a { display: grid; place-items: center; min-height: 48px; font: 600 .9375rem var(--body); color: var(--ink); text-decoration: none; }
    .bar.bottom a + a { border-left: 1px solid var(--rule); }
  }
</style>

---
import { profile } from '../data/profile'

interface Props { title: string; description: string; home?: boolean }
const { title, description, home = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
---
<!doctype html>
<html lang="en-IN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content="profile" />
  <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="627" />
  <meta property="og:image:alt" content={`${profile.name}, ${profile.role}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#09090B" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="skip" href="#content">Skip to content</a>
  {!home && (
    <header class="sub wrap">
      <a href="/" class="back"><span aria-hidden="true">←</span> {profile.name}</a>
    </header>
  )}
  <slot />
</body>
</html>

<style is:global>
  /* One neutral ramp and one tiny chromatic accent. Values are checked by scripts/contrast.mjs. */
  :root {
    --bg: #09090B; --surface: #111114; --surface-2: #17171B;
    --ink: #EDEDEF; --ink-2: #A1A1AA; --ink-3: #8E8E98; --rule: #222228;
    --c1: #8AB4FF; --c2: #B79CFF; --c3: #F09AC8;
    --chroma: linear-gradient(90deg, var(--c1), var(--c2), var(--c3));
    --sans: 'Geist', -apple-system, 'Segoe UI', system-ui, sans-serif;
    --mono: 'Geist Mono', ui-monospace, SFMono-Regular, Menlo, monospace;
    --ease: cubic-bezier(.4, 0, .2, 1);
    color-scheme: dark;
  }
  * { box-sizing: border-box; }
  html { background: var(--bg); scrollbar-gutter: stable; -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body { margin: 0; background: var(--bg); color: var(--ink-2); font: 400 1rem/1.625 var(--sans); -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
  ::selection { background: color-mix(in oklch, var(--c2) 35%, transparent); color: var(--ink); }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }
  h1, h2, h3 { color: var(--ink); font-weight: 500; text-wrap: balance; }
  :focus-visible { outline: 2px solid var(--c1); outline-offset: 3px; border-radius: 4px; }
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 24px; }
  @media (min-width: 768px) { .wrap { padding: 0 48px; } }
  .skip { position: absolute; left: -999px; top: 8px; background: var(--ink); color: var(--bg); padding: 10px 14px; border-radius: 8px; z-index: 50; }
  .skip:focus { left: 8px; }
  .sub { padding-top: 48px; }
  .back { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--ink); font-weight: 500; }
  .back span { transition: transform .2s var(--ease); }
  @media (hover: hover) { .back:hover span { transform: translateX(-4px); } }
  @media print { .sub, .skip { display: none !important; } html, body { background: #fff; color: #111; } }
</style>

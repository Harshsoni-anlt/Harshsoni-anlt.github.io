---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import ContactHub from '../../components/ContactHub.astro'
import StatusPill from '../../components/StatusPill.astro'
import { fmtDate, questCode, sortQuests } from '../../lib/achievements'
import { repoStats } from '../../lib/github'

export async function getStaticPaths() {
  const quests = sortQuests(await getCollection('quests'))
  return quests.map((q, i) => ({ params: { slug: q.id }, props: { q, prev: quests[i - 1], next: quests[i + 1] } }))
}
const { q, prev, next } = Astro.props
const d = q.data
const { Content } = await render(q)
const stats = d.repo ? await repoStats(d.repo) : null
---
<Base title={`${d.title} · ${questCode(q)} · Harsh Soni`} description={d.tagline}>
  <div data-chapter="oss">
    <header class="head wrap">
      <nav class="eyebrow crumb" aria-label="Breadcrumb"><a href="/#oss">Systems I’ve shipped</a> / {questCode(q)}</nav>
      <h1 style={`view-transition-name: q-${q.id}`}>{d.title}</h1>
      <p class="lede">{d.tagline}</p>
      <p class="meta">
        <StatusPill status={d.status} />
        {d.shipped && <span>{fmtDate(d.shipped)}</span>}
        {stats && <span>updated {fmtDate(new Date(stats.pushedAt))}</span>}
      </p>
      <p class="links">
        {d.repo && <a class="btn primary" href={`https://github.com/${d.repo}`}>Repository</a>}
        {d.linkedin && <a class="btn" href={d.linkedin}>LinkedIn post</a>}
        {d.demo && <a class="btn" href={d.demo}>Demo</a>}
      </p>
    </header>

    <div class="body wrap">
      <section class="block reveal"><h2>Problem</h2><p class="big">{d.quest}</p></section>
      <section class="block reveal">
        <h2>Measured</h2>
        <ul class="xp">{d.xp.map(x => <li class="glow"><b class="ink-fill">{x.value}</b><span>{x.label}</span></li>)}</ul>
      </section>
      <section class="block prose reveal"><h2>Built</h2><Content /></section>
      {d.limitation && <section class="block reveal"><h2>Limitation</h2><p>{d.limitation}</p></section>}
      {d.boss && (
        <section class="block boss reveal">
          <h2>Bug that nearly shipped</h2>
          <h3>{d.boss.name}</h3>
          <p>{d.boss.story}</p>
        </section>
      )}
      <section class="block reveal">
        <h2>Stack</h2>
        <p class="chips">{d.stack.map(s => <span class="chip">{s}</span>)}</p>
      </section>
      <nav class="pager" aria-label="Other systems">
        {prev ? <a href={`/quests/${prev.id}/`}>← {questCode(prev)} {prev.data.title}</a> : <span />}
        {next ? <a href={`/quests/${next.id}/`}>{questCode(next)} {next.data.title} →</a> : <a href="/#oss">All systems →</a>}
      </nav>
      <section class="cta"><h2>Want this kind of rigour on your problem?</h2><ContactHub variant="hero" /></section>
    </div>
  </div>
</Base>

<style>
  .head { padding-top: 64px; padding-bottom: 40px; border-bottom: 1px solid var(--rule); }
  .crumb a { color: var(--accent); text-decoration: none; }
  h1 { font: 750 clamp(2.25rem, 6vw, 4.5rem)/1.02 var(--display); letter-spacing: -0.03em; margin: 14px 0 14px; }
  .lede { font-size: 1.25rem; color: var(--ink-2); max-width: 60ch; margin: 0 0 18px; }
  .meta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; font: .8125rem var(--mono); color: var(--ink-2); margin: 0 0 22px; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; }
  .body { padding-top: 48px; padding-bottom: 64px; }
  .block { max-width: 820px; margin-bottom: 44px; }
  .block h2, .cta h2 { font: 500 .75rem var(--mono); text-transform: uppercase; letter-spacing: .1em; color: var(--accent); margin: 0 0 12px; }
  .big { font: 600 clamp(1.25rem, 2.2vw, 1.625rem)/1.35 var(--display); margin: 0; }
  .xp { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; }
  .xp li { padding: 20px; background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; display: flex; flex-direction: column; gap: 6px; }
  .xp b { font: 600 clamp(1.75rem, 3vw, 2.25rem)/1.05 var(--mono); letter-spacing: -0.03em; }
  .xp span { color: var(--ink-2); font-size: .9375rem; }
  .prose :global(ul) { padding-left: 20px; margin: 0; } .prose :global(li) { margin-bottom: 8px; }
  .boss { padding: 24px; border: 1px dashed var(--accent); border-radius: 6px; }
  .boss h3 { font: 700 1.375rem/1.25 var(--display); margin: 0 0 8px; }
  .boss p { margin: 0; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .chip { display: inline-flex; align-items: center; height: 28px; padding: 0 10px; border-radius: 6px; border: 1px solid var(--rule); font: 500 .8125rem var(--mono); background: var(--surface); }
  .pager { max-width: 820px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 24px 0; border-top: 1px solid var(--rule); font: .875rem var(--mono); }
  .cta { margin-top: 48px; padding: 32px; background: color-mix(in oklch, var(--accent) var(--band), var(--bg)); border-radius: 6px; max-width: 820px; }
  .cta h2 { font: 700 1.5rem/1.2 var(--display); text-transform: none; letter-spacing: -0.01em; color: var(--ink); margin-bottom: 18px; }
</style>

---
import { getCollection, render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import ContactHub from '../../components/ContactHub.astro'
import StatusPill from '../../components/StatusPill.astro'
import { fmtDate, questCode, sortQuests } from '../../lib/achievements'
import { repoStats } from '../../lib/github'

export async function getStaticPaths() {
  const quests = sortQuests(await getCollection('quests'))
  return quests.map((q, i) => ({ params: { slug: q.id }, props: { q, prev: quests[i - 1], next: quests[i + 1] } }))
}
const { q, prev, next } = Astro.props
const d = q.data
const { Content } = await render(q)
const stats = d.repo ? await repoStats(d.repo) : null
const hasDemo = Object.keys(import.meta.glob('/public/demos/*.mp4')).includes(`/public/demos/${q.id}.mp4`)
---
<Base title={`${d.title} · ${questCode(q)} · Harsh Soni`} description={d.tagline}>
  <header class="head wrap">
    <nav class="eyebrow crumb" aria-label="Breadcrumb"><a href="/#systems">Systems built in public</a><span aria-hidden="true">/</span>{questCode(q)}</nav>
    <h1 style={`view-transition-name: q-${q.id}`}>{d.title}</h1>
    <p class="lede">{d.tagline}</p>
    <p class="meta">
      <StatusPill status={d.status} />
      {d.shipped && <span>{fmtDate(d.shipped)}</span>}
      {stats && <span>updated {fmtDate(new Date(stats.pushedAt))}</span>}
    </p>
    <p class="links">
      {d.repo && <a class="btn primary" href={`https://github.com/${d.repo}`}>Repository</a>}
      {d.linkedin && <a class="btn" href={d.linkedin}>LinkedIn post</a>}
    </p>
  </header>

  <div class="body wrap">
    {hasDemo && (
      <figure class="demo ring">
        <video muted loop playsinline autoplay preload="metadata" poster={`/demos/${q.id}.jpg`}><source src={`/demos/${q.id}.mp4`} type="video/mp4" /></video>
        <figcaption>Demo, recorded from the running system.</figcaption>
      </figure>
    )}
    <section class="block"><h2>Problem</h2><p class="big">{d.quest}</p></section>
    <section class="block">
      <h2>Measured</h2>
      <ul class="xp">{d.xp.map(x => <li class="ring"><b>{x.value}</b><span>{x.label}</span></li>)}</ul>
    </section>
    <section class="block prose"><h2>Built</h2><Content /></section>
    {d.limitation && <section class="block"><h2>Limitation</h2><p>{d.limitation}</p></section>}
    {d.boss && (
      <section class="block boss">
        <h2>Bug that nearly shipped</h2>
        <h3>{d.boss.name}</h3>
        <p>{d.boss.story}</p>
      </section>
    )}
    <section class="block">
      <h2>Stack</h2>
      <p class="chips">{d.stack.map(s => <span class="chip">{s}</span>)}</p>
    </section>
    <nav class="pager" aria-label="Other systems">
      {prev ? <a href={`/quests/${prev.id}/`}>← {questCode(prev)} {prev.data.title}</a> : <span />}
      {next ? <a href={`/quests/${next.id}/`}>{questCode(next)} {next.data.title} →</a> : <a href="/#systems">All systems →</a>}
    </nav>
    <section class="cta"><h2>Want this kind of rigour on your problem?</h2><ContactHub variant="hero" /></section>
  </div>
</Base>

<style>
  .head { padding-top: 72px; padding-bottom: 40px; }
  .crumb { display: flex; gap: 10px; align-items: center; }
  .crumb a { color: var(--ink-2); text-decoration: none; display: inline-flex; align-items: center; min-height: 44px; }
  @media (hover: hover) { .crumb a:hover { color: var(--ink); } }
  h1 { font: 700 clamp(2.5rem, 6.5vw, 5rem)/1 var(--display); letter-spacing: -0.05em; margin: 8px 0 16px; }
  .lede { font-size: 1.25rem; color: var(--ink-2); max-width: 60ch; margin: 0 0 22px; }
  .meta { display: flex; gap: 14px; align-items: center; flex-wrap: wrap; font: .8125rem var(--mono); color: var(--ink-2); margin: 0 0 24px; }
  .links { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; }
  .body { padding-bottom: 80px; }
  .demo { margin: 0 0 56px; border-radius: 22px; overflow: hidden; border: 1px solid var(--rule); background: #000; max-width: 1000px; }
  .demo video { width: 100%; height: auto; display: block; aspect-ratio: 16 / 10; object-fit: cover; }
  .demo figcaption { padding: 12px 18px; font: .75rem var(--mono); color: var(--ink-2); border-top: 1px solid var(--rule); }
  .block { max-width: 840px; margin-bottom: 48px; }
  .block h2 { font: 500 .75rem var(--mono); text-transform: uppercase; letter-spacing: .14em; color: var(--ink-2); margin: 0 0 14px; }
  .big { font: 600 clamp(1.375rem, 2.4vw, 1.75rem)/1.35 var(--display); letter-spacing: -0.02em; margin: 0; }
  .xp { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  @media (max-width: 720px) { .xp { grid-template-columns: 1fr; } }
  .xp li { padding: 22px; border-radius: 22px; background: linear-gradient(180deg, var(--surface-2), var(--surface)); border: 1px solid var(--rule); display: flex; flex-direction: column; gap: 6px; }
  .xp b { font: 700 clamp(1.5rem, 2.4vw, 2rem)/1.1 var(--display); letter-spacing: -0.04em; white-space: nowrap; }
  .xp span { color: var(--ink-2); font-size: .9375rem; }
  .prose :global(ul) { padding-left: 20px; margin: 0; } .prose :global(li) { margin-bottom: 10px; color: var(--ink-2); }
  .prose :global(strong), .prose :global(code) { color: var(--ink); }
  .boss { padding: 26px 28px; border-radius: 22px; border: 1px solid var(--rule); background: var(--surface); }
  .boss h3 { font: 650 1.375rem/1.25 var(--display); letter-spacing: -0.02em; margin: 0 0 8px; }
  .boss p { margin: 0; color: var(--ink-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; }
  .chip { display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border-radius: 999px; border: 1px solid var(--rule); font: 500 .8125rem var(--mono); background: var(--surface); }
  .pager { max-width: 840px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 10px; border-top: 1px solid var(--rule); font: .875rem var(--mono); }
  .pager a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: none; color: var(--ink-2); }
  @media (hover: hover) { .pager a:hover { color: var(--ink); } }
  .cta { margin-top: 48px; padding: 34px; border-radius: 22px; max-width: 840px; background: linear-gradient(180deg, var(--surface-2), var(--surface)); border: 1px solid var(--rule); }
  .cta h2 { font: 700 1.625rem/1.2 var(--display); letter-spacing: -0.03em; color: var(--ink); margin: 0 0 20px; }
</style>

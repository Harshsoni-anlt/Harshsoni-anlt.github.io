---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { profile } from '../data/profile'
import { fmtDate, sortQuests, sortWork } from '../lib/achievements'

const quests = sortQuests(await getCollection('quests'))
const work = sortWork(await getCollection('work'))
const byOrg = (c: 'kyndryl' | 'upl') => work.filter(w => w.data.chapter === c)
const jobs = [
  { ...profile.experience[0]!, items: byOrg('kyndryl') },
  { ...profile.experience[1]!, items: byOrg('upl') },
]
---
<Base title={`${profile.name} · Résumé`} description={profile.description} print>
  <article class="cv">
    <header>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role} · {profile.employer} · {profile.location}</p>
      <p class="contact">
        <a href={`mailto:${profile.email}`}>{profile.email}</a>
        <a href={profile.linkedin}>linkedin.com/in/harsh--soni</a>
        <a href={profile.github}>github.com/Harshsoni-anlt</a>
        <a href="https://harshsoni-anlt.github.io">harshsoni-anlt.github.io</a>
      </p>
      <button class="btn sm print-btn" type="button" onclick="window.print()">Print / save as PDF</button>
    </header>

    <section><h2>Summary</h2><p>{profile.about}</p></section>

    <section>
      <h2>Experience</h2>
      {jobs.map(j => (
        <div class="job">
          <div class="jh"><h3>{j.title} · {j.org}</h3><span>{j.when}</span></div>
          <ul>
            {j.items.map(w => (
              <li><strong>{w.data.title}.</strong> {w.data.built}{w.data.metric && <> <strong>{w.data.metric}</strong> {w.data.metricNote}.</>}</li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section>
      <h2>Open-source systems</h2>
      <ul>
        {quests.map(q => (
          <li><strong>{q.data.title}</strong> ({q.data.status === 'cleared' ? fmtDate(q.data.shipped) : 'in progress'}). {q.data.resumeLine}</li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Capabilities</h2>
      <ul class="caps">{profile.capabilities.map(c => <li><strong>{c.name}:</strong> {c.detail}</li>)}</ul>
    </section>

    <section>
      <h2>Education</h2>
      {profile.education.map(e => <div class="jh"><h3>{e.title} · {e.org}</h3><span>{e.when}</span></div>)}
    </section>

    <section><h2>Awards</h2><ul>{profile.awards.map(a => <li>{a}</li>)}</ul></section>
  </article>
</Base>

<style>
  .cv { max-width: 820px; margin: 32px auto 64px; padding: 40px clamp(16px, 5vw, 56px); background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; }
  h1 { font: 750 clamp(2rem, 5vw, 3rem)/1 var(--display); margin: 0; letter-spacing: -0.02em; }
  .role { margin: 10px 0; color: var(--ink-2); font-size: 1.0625rem; }
  .contact { display: flex; flex-wrap: wrap; gap: 6px 18px; font: .8125rem var(--mono); margin: 0; }
  .print-btn { margin-top: 18px; }
  header { padding-bottom: 20px; border-bottom: 2px solid var(--ink); }
  h2 { font: 600 .75rem var(--mono); text-transform: uppercase; letter-spacing: .1em; color: var(--ink-2); margin: 28px 0 10px; }
  h3 { font: 700 1.125rem/1.3 var(--display); margin: 0; }
  .jh { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; align-items: baseline; margin-bottom: 6px; }
  .jh span { font: .8125rem var(--mono); color: var(--ink-2); }
  .job { margin-bottom: 18px; }
  ul { margin: 0; padding-left: 18px; } li { margin-bottom: 6px; font-size: .9375rem; }
  section p { margin: 0; font-size: .9375rem; }
  @media print {
    .cv { border: 0; margin: 0; padding: 0; max-width: none; background: #fff; color: #000; }
    .print-btn { display: none; }
    h2, .jh span, .role { color: #333; }
    a { color: #000; text-decoration: none; }
  }
</style>

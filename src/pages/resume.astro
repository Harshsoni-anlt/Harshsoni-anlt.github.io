---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { profile } from '../data/profile'
import { fmtDate, sortQuests, sortWork } from '../lib/achievements'

const quests = sortQuests(await getCollection('quests'))
const work = sortWork(await getCollection('work'))
const CHAPTER = { Kyndryl: 'kyndryl', UPL: 'upl' } as Record<string, string>
const jobs = profile.experience.map(e => ({ ...e, items: work.filter(w => w.data.chapter === CHAPTER[e.org]) }))
---
<Base title={`${profile.name}, Résumé`} description={profile.description}>
  <article class="wrap cv">
    <header>
      <h1>{profile.name}</h1>
      <p class="role">{profile.role} · {profile.location}</p>
      <ul class="contact" aria-label="Contact">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.linkedin}>linkedin.com/in/harsh--soni</a></li>
        <li><a href={profile.github}>github.com/Harshsoni-anlt</a></li>
        <li class="print"><button type="button" onclick="window.print()">Print or save as PDF</button></li>
      </ul>
    </header>

    <section>
      <h2>Summary</h2>
      {profile.about.map(p => <p>{p}</p>)}
    </section>

    <section>
      <h2>Experience</h2>
      {jobs.map(j => (
        <div class="item" id={j.id}>
          <div class="ih"><h3>{j.title} · {j.org}</h3><span>{j.when}</span></div>
          <p>{j.line}</p>
          {j.items.length > 0 && (
            <ul>
              {j.items.map(w => (
                <li><strong>{w.data.title}.</strong> {w.data.built}{w.data.metric && <> Result: {w.data.metric} {w.data.metricNote}.</>}</li>
              ))}
            </ul>
          )}
        </div>
      ))}
    </section>

    <section>
      <h2>Open source</h2>
      <ul>
        {quests.map(q => (
          <li><strong>{q.data.title}</strong> ({q.data.status === 'cleared' ? fmtDate(q.data.shipped) : 'in progress'}). {q.data.resumeLine}</li>
        ))}
      </ul>
    </section>

    <section>
      <h2>Awards, events & certifications</h2>
      <ul>{profile.awards.map(a => <li><strong>{a.title}</strong> ({a.when}). {a.line}</li>)}</ul>
    </section>

    <section>
      <h2>Education</h2>
      {profile.education.map(e => (
        <div class="item">
          <div class="ih"><h3>{e.title} · {e.org}</h3><span>{e.when}</span></div>
          {'line' in e && <p>{e.line}</p>}
        </div>
      ))}
    </section>
  </article>
</Base>

<style>
  .cv { max-width: 760px; padding-top: 32px; padding-bottom: 96px; }
  h1 { font-size: clamp(2rem, 5vw, 2.75rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; }
  .role { margin-top: 8px; color: var(--ink); font-size: 1.0625rem; }
  .contact { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 20px; font-size: .9375rem; }
  .contact a, .contact button { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); text-decoration: underline; text-decoration-color: var(--rule); text-underline-offset: 5px; }
  .contact button { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  @media (hover: hover) { .contact a:hover, .contact button:hover { text-decoration-color: var(--ink-3); } }
  header { padding-bottom: 24px; border-bottom: 1px solid var(--rule); }
  h2 { font: 500 .75rem/1 var(--sans); text-transform: uppercase; letter-spacing: .14em; color: var(--ink); margin: 40px 0 16px; }
  h3 { font-size: 1rem; line-height: 1.4; }
  .ih { display: flex; justify-content: space-between; gap: 4px 16px; flex-wrap: wrap; align-items: baseline; margin-bottom: 6px; }
  @media (min-width: 640px) { .ih { display: grid; grid-template-columns: 1fr auto; } }
  .ih span { font: 500 .75rem var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }
  .item + .item { margin-top: 28px; }
  .item { scroll-margin-top: 24px; }
  .item:first-of-type { scroll-margin-top: 64px; } /* keep the section heading above the first job in view */
  :global(.sub) { max-width: 760px; }
  section p + p { margin-top: 12px; }
  ul { margin: 12px 0 0; padding-left: 18px; }
  section > ul:first-of-type { margin-top: 0; }
  li { margin-bottom: 8px; font-size: .9375rem; }
  li strong { color: var(--ink); font-weight: 500; }
  @media print {
    .cv { max-width: none; padding: 0; }
    .print { display: none; }
    h1, h2, h3, .role, li strong, .contact a { color: #000; }
    .ih span { color: #444; }
    .contact a { text-decoration: none; }
  }
</style>

---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import QuestMap from '../components/QuestMap.astro'
import { profile } from '../data/profile'
import { achievements, fmtDate, questCode, sortQuests } from '../lib/achievements'

const quests = sortQuests(await getCollection('quests'))
const badges = achievements(quests)
const cleared = quests.filter(q => q.data.status === 'cleared')
---
<Base title={`${profile.name} · ${profile.role}`} description={profile.summary} mode="adventure">
  <section class="hero">
    <p class="eyebrow">{profile.role} · {profile.location}</p>
    <h1>{profile.headline}</h1>
    <p class="lede">{profile.summary}</p>
    <div class="cta">
      <a class="btn primary" href="/resume/">Recruiter view</a>
      <a class="btn" href={profile.github}>GitHub</a>
      {profile.linkedin && <a class="btn" href={profile.linkedin}>LinkedIn</a>}
    </div>
  </section>

  <section aria-labelledby="map-h">
    <h2 id="map-h" class="sr">The trail</h2>
    <QuestMap quests={quests} />
  </section>

  <section class="log" aria-labelledby="log-h">
    <div class="sec-head">
      <h2 id="log-h">Quest log</h2>
      <p class="eyebrow">{cleared.length} cleared · {quests.length - cleared.length} in progress</p>
    </div>
    <ol class="quests">
      {quests.map(q => (
        <li class={`quest ${q.data.status}`}>
          <a href={`/quests/${q.id}/`}>
            <span class="eyebrow">{questCode(q)} · {q.data.status === 'cleared' ? `cleared ${fmtDate(q.data.shipped)}` : 'in progress'}</span>
            <h3>{q.data.title}</h3>
            <p>{q.data.tagline}</p>
            <p class="xp"><span class="xp-v">{q.data.xp[0]!.value}</span> {q.data.xp[0]!.label}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="ach-h">
    <div class="sec-head">
      <h2 id="ach-h">Achievements</h2>
      <p class="eyebrow">computed from the quest files on every build</p>
    </div>
    <ul class="badges">
      {badges.map(b => (
        <li>
          <span class="seal" aria-hidden="true">✦</span>
          <strong>{b.name}</strong>
          <span>{b.detail}</span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="journey-h">
    <div class="sec-head"><h2 id="journey-h">Before the trail</h2><p class="eyebrow">the day job</p></div>
    <ol class="journey">
      {profile.experience.map(x => (
        <li>
          <span class="eyebrow">{x.when}</span>
          <h3>{x.title} <span class="org">· {x.org}</span></h3>
          <p>{x.what}</p>
        </li>
      ))}
      {profile.education.map(x => (
        <li>
          <span class="eyebrow">{x.when}</span>
          <h3>{x.title} <span class="org">· {x.org}</span></h3>
        </li>
      ))}
    </ol>
  </section>

  <section aria-labelledby="code-h">
    <div class="sec-head"><h2 id="code-h">House rules</h2><p class="eyebrow">the same on every quest</p></div>
    <ul class="rules">{profile.discipline.map(d => <li><strong>{d.rule}</strong> {d.why}</li>)}</ul>
  </section>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .hero { padding: 40px 0 36px; max-width: 760px; }
  h1 { font-size: clamp(34px, 6vw, 60px); margin: 10px 0 16px; font-weight: 700; }
  .lede { font-size: 18px; color: var(--ink-2); margin: 0 0 24px; max-width: 640px; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; }
  section { margin-bottom: 56px; }
  .sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; border-bottom: 1.5px solid var(--ink); padding-bottom: 8px; margin-bottom: 18px; }
  .sec-head h2 { margin: 0; font-size: 28px; }
  .quests { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 14px; }
  .quest a { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 18px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); text-decoration: none; transition: transform .15s, border-color .15s; }
  .quest a:hover { transform: translateY(-2px); border-color: var(--route); color: inherit; }
  .quest h3 { margin: 4px 0 0; font-size: 22px; }
  .quest p { margin: 0; color: var(--ink-2); font-size: 15px; }
  .quest.in-progress a { border-style: dashed; }
  .xp { margin-top: auto !important; padding-top: 10px; border-top: 1px dashed var(--line); font: 13px/1.4 var(--mono); }
  .xp-v { color: var(--cleared); font-weight: 600; }
  .in-progress .xp-v { color: var(--active); }
  .badges { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .badges li { display: grid; grid-template-columns: 34px 1fr; column-gap: 10px; padding: 14px; border-radius: 12px; border: 1px solid var(--line); background: var(--card); }
  .seal { grid-row: span 2; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: var(--route); color: var(--paper); font-size: 15px; }
  .badges strong { font-family: var(--display); font-size: 17px; }
  .badges span:last-child { color: var(--ink-2); font-size: 14px; }
  .journey { list-style: none; margin: 0; padding: 0 0 0 22px; border-left: 2px dashed var(--route); display: grid; gap: 22px; max-width: 820px; }
  .journey li { position: relative; }
  .journey li::before { content: ''; position: absolute; left: -30px; top: 4px; width: 12px; height: 12px; border-radius: 50%; background: var(--paper); border: 2.5px solid var(--route); }
  .journey h3 { margin: 4px 0 4px; font-size: 21px; }
  .journey .org { color: var(--ink-2); font-weight: 500; }
  .journey p { margin: 0; color: var(--ink-2); }
  .rules { margin: 0; padding-left: 20px; display: grid; gap: 10px; max-width: 760px; }
  .rules strong { font-weight: 600; }
</style>

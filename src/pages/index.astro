---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import ContactHub from '../components/ContactHub.astro'
import StatusPill from '../components/StatusPill.astro'
import SpotTheField from '../components/SpotTheField.astro'
import Constellation from '../components/Constellation.astro'
import Terminal from '../components/Terminal.astro'
import { profile } from '../data/profile'
import { JOURNEY } from '../data/places'
import { fmtDate, questCode, sortQuests, sortWork } from '../lib/achievements'

const quests = sortQuests(await getCollection('quests'))
const work = sortWork(await getCollection('work'))
const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date)
const latest = logs.find(l => l.data.kind === 'tested')
const MOD = { text: 'Decisions', video: 'Video', audio: 'Voice', image: 'Vision', data: 'Data + agents' }
// Resolved from the project root by Vite, so it works whatever directory the build runs from.
const DEMOS = Object.keys(import.meta.glob('/public/demos/*.mp4'))
const demo = (id: string) => (DEMOS.includes(`/public/demos/${id}.mp4`) ? `/demos/${id}` : null)
const TECH = ['Agentic AI', 'LangGraph', 'MCP', 'RAG', 'Azure OpenAI', 'AWS Bedrock', 'Textract', 'Gemini', 'vLLM', 'Small models', 'Model evaluation', 'Forecasting', 'Databricks', 'FastAPI', 'Kubernetes', 'MLflow', 'Computer vision', 'Voice AI']
---
<Base title={`${profile.name} · ${profile.role}`} description={profile.description}>
  <div id="world-wrap" aria-hidden="true">
    <div class="world-poster"></div>
    <canvas id="world"></canvas>
    <div id="world-labels"></div>
  </div>

  <section id="hero" class="hero wrap" aria-labelledby="hero-h">
    <p class="eyebrow" data-hero-in>{profile.role} · {profile.employer} · {profile.location}</p>
    <h1 id="hero-h"><span data-split>{profile.name}</span></h1>
    <p class="line" data-hero-in>I make AI work inside<br /><span class="rot-mask"><span class="rot" data-rotate="banks|supply chains|warehouses|regulated enterprises|whatever ships next">banks</span></span><br />and measure it before I promise it.</p>
    <div class="cta" data-hero-in>
      <ContactHub variant="hero" />
      <button class="btn wizard" type="button" data-open-terminal data-magnetic>Ask the wizard <kbd>⌘K</kbd></button>
    </div>
    <ul class="chips" data-hero-in>
      <li>Forward Deployed AI Engineer · Kyndryl</li>
      <li>UPL OpenAg Award 2025</li>
      <li>{quests.length} open-source systems</li>
      <li>5+ years, POC → production</li>
    </ul>
    <a class="cue" href="#journey" aria-label="Scroll to the journey"><span></span></a>
  </section>

  <section id="journey" aria-labelledby="journey-h">
    <div class="jwrap wrap">
      <h2 id="journey-h" class="eyebrow">The journey so far</h2>
      <ol class="steps">
        {JOURNEY.map((s, i) => (
          <li class={`step ${i === 0 ? 'active' : ''}`}>
            <span class="when">{s.when}</span>
            <h3>{s.title}</h3>
            <p>{s.line}</p>
          </li>
        ))}
      </ol>
      <div class="rail" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="track">{[...TECH, ...TECH].map(t => <span>{t}<i>✦</i></span>)}</div>
  </div>

  <Constellation />

  <section id="systems" class="wrap block" aria-labelledby="sys-h">
    <div class="head" data-reveal>
      <p class="eyebrow">Built in public</p>
      <h2 id="sys-h">Systems I’ve shipped</h2>
      <p class="intro">Each one takes a new AI capability into a real constraint: your data, your footage, your voice, your photos, your decisions. Hover to watch it work.</p>
    </div>
    <ol class="cards" data-stagger>
      {quests.map(q => {
        const d = demo(q.id)
        return (
          <li class={`card ${d ? '' : 'nodemo'}`} data-demo={d ? '' : undefined}>
            <a href={`/quests/${q.id}/`}>
              <div class="media">
                {d ? (
                  <video muted loop playsinline preload="none" poster={`${d}.jpg`} aria-hidden="true"><source src={`${d}.mp4`} type="video/mp4" /></video>
                ) : (
                  <div class="nomedia"><span>68%</span><small>of decisions kept on the laptop</small></div>
                )}
                <span class="mod">{MOD[q.data.modality]}</span>
              </div>
              <div class="body">
                <span class="code">{questCode(q)} · {q.data.status === 'cleared' ? fmtDate(q.data.shipped) : 'in progress'}</span>
                <h3 style={`view-transition-name: q-${q.id}`}>{q.data.title}</h3>
                <p>{q.data.tagline}</p>
                <span class="more">Open the case <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        )
      })}
    </ol>
    <SpotTheField />
  </section>

  <section id="work" class="wrap block" aria-labelledby="work-h">
    <div class="head" data-reveal>
      <p class="eyebrow">Inside the enterprise</p>
      <h2 id="work-h">The day job: AI that has to work on Monday</h2>
      <p class="intro">Regulated banks, global supply chains, platforms other teams build on. Client names stay private; the work doesn’t.</p>
    </div>
    <ol class="ent" data-stagger>
      {work.map(w => (
        <li class={`ecard ${w.data.chapter}`}>
          <div class="etop"><span class="org">{w.data.chapter === 'kyndryl' ? 'Kyndryl' : 'UPL'}</span><StatusPill status={w.data.status} /></div>
          <h3>{w.data.title}</h3>
          <p>{w.data.problem ?? w.data.built}</p>
          {w.data.metric && <p class="metric"><b>{w.data.metric}</b> {w.data.metricNote?.split('·')[0]}</p>}
        </li>
      ))}
    </ol>
  </section>

  <section id="next" class="wrap block" aria-labelledby="next-h">
    <div class="head" data-reveal>
      <p class="eyebrow">Next quest</p>
      <h2 id="next-h">{profile.next.title}</h2>
      <p class="intro">New models ship every week. I test which ones hold up on real data, and I’m building toward four things at once.</p>
    </div>
    <ol class="paths" data-stagger>
      {profile.next.paths.map((p, i) => (
        <li><span class="n">0{i + 1}</span><h3>{p.name}</h3><p>{p.line}</p></li>
      ))}
    </ol>
    {latest && (
      <a class="lab" href={`/log/#${latest.id}`} data-reveal>
        <span class="eyebrow">Field log · {fmtDate(latest.data.date)}</span>
        <strong>{latest.data.title}</strong>
        <span>{latest.data.result}</span>
        <span class="more">Read the numbers →</span>
      </a>
    )}
  </section>

  <section id="off" class="wrap block small" aria-labelledby="off-h">
    <h2 id="off-h" class="eyebrow">Off the clock</h2>
    <ul class="off" data-stagger>
      {profile.offClock.map(o => <li><strong>{o.name}</strong><span>{o.line}</span></li>)}
    </ul>
  </section>

  <section id="contact" class="wrap block" aria-labelledby="contact-h">
    <div class="head" data-reveal>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-h">Hiring, or have a process AI should fix?</h2>
      <p class="intro">Pick the fastest way. Or press <kbd>⌘K</kbd> and type <code>hire</code>.</p>
    </div>
    <ContactHub variant="full" />
    <div id="about" class="about" data-reveal>
      <h3 class="eyebrow">About</h3>
      <p>{profile.about}</p>
    </div>
  </section>

  <Terminal />
</Base>

<script>
  import '../scripts/motion'
</script>

<style>
  /* ---------- 3D world layer ---------- */
  #world-wrap { position: fixed; inset: 0; z-index: 0; pointer-events: none; }
  #world, .world-poster { position: absolute; inset: 0; width: 100%; height: 100%; }
  .world-poster {
    background:
      radial-gradient(40vw 40vw at 22% 30%, color-mix(in oklch, var(--oss) 22%, transparent), transparent 70%),
      radial-gradient(36vw 36vw at 78% 62%, color-mix(in oklch, var(--kyndryl) 18%, transparent), transparent 70%),
      radial-gradient(30vw 30vw at 60% 18%, color-mix(in oklch, var(--frontier) 14%, transparent), transparent 70%);
    transition: opacity 1s;
  }
  :global(.world-on) .world-poster { opacity: .35; }
  #world-labels { position: absolute; inset: 0; overflow: hidden; }
  #world-labels :global(.w-label) {
    position: absolute; left: 0; top: 0; white-space: nowrap; opacity: 0; transition: opacity .4s;
    font: 600 .75rem/1 var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink);
    padding: 5px 8px; border-radius: 4px; background: color-mix(in oklch, var(--bg) 70%, transparent);
  }
  #world-labels :global(.w-label.travel) { font-weight: 500; color: var(--ink-2); font-size: .6875rem; }
  #world-labels :global(.w-label.on) { color: var(--bg); background: var(--ink); }
  main > :not(#world-wrap) { position: relative; z-index: 1; }

  /* ---------- hero ---------- */
  .hero { min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding-top: 80px; padding-bottom: 80px; }
  h1 { font: 800 clamp(3.5rem, 13vw, 11.5rem)/.86 var(--display); letter-spacing: -0.045em; margin: 18px 0 22px; }
  h1 :global(.w) { display: inline-block; overflow: hidden; padding-bottom: .06em; vertical-align: top; }
  h1 :global(.c) { display: inline-block; background: linear-gradient(100deg, var(--ink) 40%, var(--oss) 70%, var(--frontier)); -webkit-background-clip: text; background-clip: text; color: transparent; background-size: 300% 100%; background-position: 0 0; }
  .line { font: 600 clamp(1.25rem, 2.6vw, 2.1rem)/1.25 var(--display); margin: 0 0 30px; max-width: 30ch; letter-spacing: -0.01em; }
  .rot-mask { display: inline-block; overflow: hidden; vertical-align: bottom; padding-bottom: .08em; }
  .rot { display: inline-block; font-size: 1.5em; line-height: 1.15; background: var(--spectrum); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
  .wizard { gap: 10px; border-color: color-mix(in oklch, var(--ink) 40%, transparent); background: color-mix(in oklch, var(--surface) 60%, transparent); backdrop-filter: blur(8px); }
  kbd { font: 500 .75rem var(--mono); padding: 3px 6px; border: 1px solid var(--rule); border-radius: 4px; background: var(--surface); color: var(--ink-2); }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 8px; padding: 0; margin: 28px 0 0; }
  .chips li { font: 500 .8125rem var(--mono); padding: 7px 12px; border-radius: 999px; border: 1px solid var(--rule); background: color-mix(in oklch, var(--bg) 60%, transparent); backdrop-filter: blur(6px); }
  .cue { position: absolute; bottom: 28px; left: 50%; translate: -50% 0; width: 26px; height: 42px; border: 1.5px solid var(--ink-2); border-radius: 14px; }
  .cue span { position: absolute; left: 50%; top: 8px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 2px; background: var(--ink); animation: cue 1.8s ease-in-out infinite; }
  @keyframes cue { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }

  /* ---------- journey ---------- */
  .jwrap { padding-top: 96px; padding-bottom: 96px; }
  .steps { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 28px; max-width: 520px; }
  .step { padding: 22px 24px; border-radius: 10px; background: color-mix(in oklch, var(--surface) 70%, transparent); border: 1px solid var(--rule); backdrop-filter: blur(10px); }
  .when { font: 500 .75rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--frontier); }
  .step h3 { font: 750 clamp(1.75rem, 4vw, 3rem)/1.05 var(--display); margin: 8px 0 10px; letter-spacing: -0.02em; }
  .step p { margin: 0; color: var(--ink-2); font-size: 1.0625rem; }
  .rail { display: none; }
  :global(.world-on) #journey .jwrap { height: 100svh; padding-top: 0; padding-bottom: 0; display: flex; flex-direction: column; justify-content: center; position: relative; }
  :global(.world-on) .steps { position: relative; height: 300px; display: block; }
  :global(.world-on) .step { position: absolute; inset: 0 auto auto 0; width: 100%; opacity: 0; transform: translateY(30px); transition: opacity .6s, transform .6s cubic-bezier(.2,.7,.2,1); pointer-events: none; }
  :global(.world-on) .step.active { opacity: 1; transform: none; }
  :global(.world-on) .rail { display: block; position: absolute; left: 32px; right: 32px; bottom: 48px; height: 2px; background: var(--rule); }
  :global(.world-on) .rail i { display: block; height: 100%; background: var(--spectrum); transform-origin: left; transform: scaleX(var(--jp, 0)); }
  @media (max-width: 720px) {
    /* On a phone the story card sits low so the camera's city stays visible above it. */
    :global(.world-on) #journey .jwrap { justify-content: flex-end; padding-bottom: 96px; }
    :global(.world-on) .steps { height: 230px; }
    :global(.world-on) .step { padding: 16px 18px; }
    :global(.world-on) .step h3 { font-size: 1.625rem; }
    :global(.world-on) .step p { font-size: .9375rem; }
    :global(.world-on) .rail { left: 16px; right: 16px; bottom: 76px; }
  }

  /* ---------- marquee ---------- */
  .marquee { overflow: hidden; border-block: 1px solid var(--rule); padding: 18px 0; background: color-mix(in oklch, var(--bg) 80%, transparent); }
  .track { display: flex; width: max-content; animation: marquee 40s linear infinite; }
  .track span { font: 700 clamp(1.25rem, 2.6vw, 2rem)/1 var(--display); padding-right: 28px; white-space: nowrap; color: var(--ink-2); }
  .track i { font-style: normal; color: var(--frontier); padding-left: 28px; font-size: .7em; vertical-align: middle; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .track { animation: none; flex-wrap: wrap; width: auto; } .cue span { animation: none; } }

  /* ---------- shared blocks ---------- */
  .block { padding-top: 120px; padding-bottom: 40px; }
  .head { max-width: 760px; margin-bottom: 44px; }
  .head h2 { font: 750 clamp(2.25rem, 5.5vw, 4.5rem)/1 var(--display); letter-spacing: -0.035em; margin: 12px 0 16px; }
  .intro { color: var(--ink-2); font-size: 1.125rem; margin: 0; }
  code { font: .9em var(--mono); padding: 1px 5px; border-radius: 4px; background: var(--surface); }

  /* ---------- systems: demo cards ---------- */
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 18px; }
  .card a { display: flex; flex-direction: column; height: 100%; border-radius: 14px; overflow: hidden; background: var(--surface); border: 1px solid var(--rule); text-decoration: none; transition: transform .35s cubic-bezier(.2,.7,.2,1), border-color .3s, box-shadow .35s; }
  .card a:hover, .card a:focus-visible { transform: translateY(-6px); border-color: color-mix(in oklch, var(--oss) 60%, var(--rule)); box-shadow: 0 30px 60px -30px color-mix(in oklch, var(--oss) 50%, transparent); }
  .media { position: relative; aspect-ratio: 16 / 10; background: #05060b; overflow: hidden; }
  .media video { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.85) brightness(.85); transition: filter .4s, transform .6s; }
  .card.playing video, .card a:hover video { filter: none; transform: scale(1.03); }
  .nomedia { height: 100%; display: grid; place-content: center; text-align: center; background: radial-gradient(circle at 50% 40%, color-mix(in oklch, var(--frontier) 30%, transparent), transparent 70%); }
  .nomedia span { font: 800 4.5rem/1 var(--display); background: var(--spectrum); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nomedia small { color: var(--ink-2); font: .8125rem var(--mono); }
  .mod { position: absolute; left: 12px; top: 12px; font: 600 .6875rem var(--mono); letter-spacing: .08em; text-transform: uppercase; padding: 5px 9px; border-radius: 999px; background: color-mix(in oklch, var(--bg) 75%, transparent); backdrop-filter: blur(6px); }
  .body { padding: 20px 22px 22px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .code { font: .75rem var(--mono); color: var(--oss); letter-spacing: .04em; }
  .body h3 { font: 750 1.625rem/1.1 var(--display); margin: 0; letter-spacing: -0.02em; }
  .body p { margin: 0; color: var(--ink-2); font-size: .9875rem; }
  .more { margin-top: auto; padding-top: 10px; font: 600 .875rem var(--body); color: var(--ink); }
  .card a:hover .more span { display: inline-block; transform: translateX(4px); transition: transform .2s; }

  /* ---------- enterprise ---------- */
  .ent { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .ecard { padding: 24px; border-radius: 14px; border: 1px solid var(--rule); background: color-mix(in oklch, var(--surface) 92%, transparent); position: relative; overflow: hidden; }
  .ecard::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--c); }
  .ecard.kyndryl { --c: var(--kyndryl); } .ecard.upl { --c: var(--upl); }
  .etop { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 14px; }
  .org { font: 600 .75rem var(--mono); letter-spacing: .1em; text-transform: uppercase; color: var(--c); }
  .ecard h3 { font: 700 1.3125rem/1.2 var(--display); margin: 0 0 8px; }
  .ecard p { margin: 0; color: var(--ink-2); font-size: .9375rem; }
  .metric { margin-top: 12px !important; color: var(--ink) !important; }
  .metric b { color: var(--c); font-family: var(--mono); }

  /* ---------- next quest ---------- */
  .paths { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
  .paths li { padding: 26px; border-radius: 14px; border: 1px solid var(--rule); background: linear-gradient(160deg, color-mix(in oklch, var(--frontier) 10%, var(--surface)), var(--surface) 60%); transition: transform .3s, border-color .3s; }
  .paths li:hover { transform: translateY(-4px); border-color: var(--frontier); }
  .n { font: 600 .8125rem var(--mono); color: var(--frontier); }
  .paths h3 { font: 700 1.375rem/1.15 var(--display); margin: 10px 0 8px; }
  .paths p { margin: 0; color: var(--ink-2); font-size: .9375rem; }
  .lab { display: grid; gap: 6px; margin-top: 18px; padding: 24px 26px; border-radius: 14px; border: 1px dashed var(--frontier); text-decoration: none; }
  .lab strong { font: 700 1.375rem/1.2 var(--display); }
  .lab span:not(.eyebrow):not(.more) { color: var(--ink-2); }

  /* ---------- off the clock ---------- */
  .small { padding-top: 96px; }
  .off { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0; border-top: 1px solid var(--rule); }
  .off li { padding: 18px 18px 18px 0; display: flex; flex-direction: column; gap: 4px; border-bottom: 1px solid var(--rule); }
  .off strong { font: 700 1.125rem var(--display); }
  .off span { color: var(--ink-2); font-size: .9375rem; }

  /* ---------- contact ---------- */
  #contact { padding-bottom: 96px; }
  .about { margin-top: 56px; max-width: 72ch; }
  .about p { font-size: 1.0625rem; color: var(--ink-2); }

  @media (max-width: 720px) {
    .block { padding-top: 88px; }
    .cards, .ent { grid-template-columns: 1fr; }
    .hero { padding-top: 64px; }
  }
</style>

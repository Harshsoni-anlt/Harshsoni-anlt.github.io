---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import Chapter from '../components/Chapter.astro'
import ContactHub from '../components/ContactHub.astro'
import StatusPill from '../components/StatusPill.astro'
import SpotTheField from '../components/SpotTheField.astro'
import { profile } from '../data/profile'
import { fmtDate, level, questCode, sortQuests, sortWork, wizardUnlocked } from '../lib/achievements'

const quests = sortQuests(await getCollection('quests'))
const work = sortWork(await getCollection('work'))
const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date)
const tested = logs.filter(l => l.data.kind === 'tested' && l.data.home).slice(0, 3)
const tracking = logs.find(l => l.data.kind === 'tracking')

const kyndryl = work.filter(w => w.data.chapter === 'kyndryl')
const lead = kyndryl.find(w => w.data.size === 'lead')
const shorts = kyndryl.filter(w => w.data.size === 'short')
const upl = work.filter(w => w.data.chapter === 'upl')

const lv = level(quests, work)
const wizard = wizardUnlocked(quests, work)
const gridRows = [
  ...quests.map(q => ({ name: q.data.title, href: `/quests/${q.id}/`, t: q.data.traits })),
  ...work.filter(w => Object.values(w.data.traits).some(Boolean)).map(w => ({ name: w.data.title, href: undefined, t: w.data.traits })),
]
const MOD = { text: 'Text', video: 'Video', audio: 'Voice', image: 'Image', data: 'Data' }

if (+new Date() - +(logs[0]?.data.date ?? 0) > 90 * 864e5) console.warn('[field log] newest entry is older than 90 days')
---
<Base title={`${profile.name} · ${profile.role}`} description={profile.description}>
  <section class="hero wrap" aria-labelledby="hero-h">
    <p class="eyebrow">{profile.eyebrow}</p>
    <h1 id="hero-h">{profile.headline.before}<em class="measure">{profile.headline.em}</em>{profile.headline.after}</h1>
    <p class="sub">{profile.subline}</p>
    <ContactHub variant="hero" />
    <p class="avail">{profile.availability.text} · as of {profile.availability.asOf}</p>
    <div class="spectrum" role="img" aria-label="Colour key: teal Kyndryl, amber UPL, violet open source, magenta frontier">
      <span style="--c: var(--kyndryl)">Kyndryl</span><span style="--c: var(--upl)">UPL</span><span style="--c: var(--oss)">Open source</span><span style="--c: var(--frontier)">Frontier</span>
    </div>
  </section>

  <section class="proof wrap reveal" aria-label="Results">
    {profile.proof.map(p => (
      <div class="stat">
        <span class="num ink-fill">{p.value}</span>
        <span class="cap">{p.label}</span>
      </div>
    ))}
  </section>

  <Chapter chapter="kyndryl" title="Kyndryl: Lead II, Forward Deployed Engineer" when="Jan 2026 – present">
    <div class="spread">
      {lead && (
        <article class="lead glow">
          <div class="row-top"><StatusPill status={lead.data.status} /></div>
          <h3>{lead.data.title}</h3>
          <dl>
            {lead.data.problem && <><dt>Problem</dt><dd>{lead.data.problem}</dd></>}
            {lead.data.constraint && <><dt>Constraint</dt><dd>{lead.data.constraint}</dd></>}
            <dt>Built</dt><dd>{lead.data.built}</dd>
          </dl>
        </article>
      )}
      <div class="shorts">
        {shorts.map(w => (
          <article class="short glow">
            <div class="row-top"><StatusPill status={w.data.status} /></div>
            <h3>{w.data.title}</h3>
            <p>{w.data.built}</p>
          </article>
        ))}
      </div>
    </div>
  </Chapter>

  <Chapter chapter="upl" title="UPL: Data Scientist" when="Jan 2022 – Jan 2026">
    <ol class="ledger">
      {upl.map(w => (
        <li class="glow">
          <span class="lnum">{w.data.metric ? <span class="ink-fill">{w.data.metric}</span> : <span class="dash" aria-label="no figure">—</span>}</span>
          <div>
            <h3>{w.data.title}</h3>
            {w.data.metricNote && <p class="note">{w.data.metric} {w.data.metricNote}</p>}
            <p>{w.data.built}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="awards">{profile.awards.slice(0, 2).join(' · ')}</p>
  </Chapter>

  <Chapter chapter="oss" title="Systems I’ve shipped" intro="Each one tests a new AI capability against real constraints. Measured, limitations written down. Clone it, break it.">
    <ol class="index">
      {quests.map(q => (
        <li class={`qrow glow ${q.data.featured ? 'featured' : ''}`}>
          <a href={`/quests/${q.id}/`} class="qlink">
            <span class="qcode">{questCode(q)}</span>
            <span class="qmain">
              <span class="qtitle" style={`view-transition-name: q-${q.id}`}>{q.data.title}</span>
              <span class="qhead">{q.data.headline}</span>
              {q.data.limitation && <span class="qlim">Limitation: {q.data.limitation}</span>}
              {q.data.featured && q.data.boss && <span class="qboss">Bug that nearly shipped: {q.data.boss.name.toLowerCase()}.</span>}
            </span>
            <span class="qside">
              <span class="chip">{MOD[q.data.modality]}</span>
              {q.data.status === 'cleared' ? <span class="qdate">{fmtDate(q.data.shipped)}</span> : <StatusPill status="in-progress" />}
              <span class="arrow" aria-hidden="true">→</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
    <SpotTheField />
  </Chapter>

  <section class="method wrap reveal" aria-labelledby="method-h">
    <p class="eyebrow">The method</p>
    <h2 id="method-h">Same four rules, every system</h2>
    {wizard && <p class="hud">LV {lv} · SOLUTION WIZARD unlocked: four input types shipped in the open, and AI running in production at work.</p>}
    <table class="grid">
      <thead><tr><th scope="col">System</th>{profile.method.map(m => <th scope="col">{m.label}</th>)}</tr></thead>
      <tbody>
        {gridRows.map((r, i) => (
          <tr style={`--i: ${i}`}>
            <th scope="row">{r.href ? <a href={r.href}>{r.name}</a> : r.name}</th>
            {profile.method.map(m => {
              const v = r.t[m.key as keyof typeof r.t]
              return <td data-label={m.label} class={v ? 'lit' : 'empty'}>{v ?? '—'}</td>
            })}
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <Chapter chapter="frontier" title="What I’m testing now" intro="New models ship weekly. I check which ones hold up on real data.">
    <p class="eyebrow last">Last entry: {fmtDate(logs[0]?.data.date)}</p>
    <ol class="log">
      {tested.map(l => (
        <li class="glow">
          <a href={`/log/#${l.id}`}>
            <span class="ldate">{fmtDate(l.data.date)}</span>
            <span class="lbody"><strong>{l.data.title}</strong>{l.data.model && <span class="lmodel">{l.data.model}</span>}<span>{l.data.result}</span></span>
            {l.data.tag && <span class="chip">{l.data.tag}</span>}
          </a>
        </li>
      ))}
    </ol>
    {tracking && (
      <details class="tracking"><summary>Also tracking</summary><p>{tracking.data.result}</p></details>
    )}
  </Chapter>

  <section class="caps wrap reveal" aria-labelledby="caps-h">
    <p class="eyebrow">Capabilities</p>
    <h2 id="caps-h" class="sr">Capabilities</h2>
    <ul>
      {profile.capabilities.map(c => (
        <li><span class="cname">{'href' in c && c.href ? <a href={c.href}>{c.name}</a> : c.name}</span><span class="cdetail">{c.detail}</span></li>
      ))}
    </ul>
  </section>

  <section id="contact" class="contact wrap reveal" aria-labelledby="contact-h">
    <p class="eyebrow">Contact</p>
    <h2 id="contact-h">Hiring, or have a process AI should fix? Pick the fastest way.</h2>
    <ContactHub variant="full" />
    <div id="about" class="about">
      <h3>About</h3>
      <p>{profile.about}</p>
    </div>
  </section>
</Base>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .hero { padding-top: clamp(56px, 12vh, 140px); padding-bottom: 56px; min-height: min(85vh, 860px); display: flex; flex-direction: column; justify-content: center; }
  h1 { font: 750 clamp(2.125rem, 6vw + .5rem, 5.5rem)/1.02 var(--display); letter-spacing: -0.03em; margin: 18px 0 22px; max-width: 16ch; }
  .measure {
    font-style: normal; background: var(--spectrum); background-size: 200% 100%;
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .measure { animation: slide linear both; animation-timeline: scroll(root); animation-range: 0 100vh; }
    }
  }
  @keyframes slide { from { background-position: 0 0; } to { background-position: 100% 0; } }
  .sub { font-size: clamp(1.0625rem, 1.4vw, 1.25rem); color: var(--ink-2); max-width: 58ch; margin: 0 0 28px; }
  .avail { margin: 16px 0 0; font: .8125rem var(--mono); color: var(--ink-2); }
  .spectrum { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-top: 40px; max-width: 560px; }
  .spectrum span { border-top: 4px solid var(--c); padding-top: 8px; font: 500 .6875rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }

  .proof { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); margin-bottom: 0; }
  .stat { padding: 36px 24px 32px 0; display: flex; flex-direction: column; gap: 10px; }
  .stat + .stat { padding-left: 24px; border-left: 1px solid var(--rule); }
  .num { font: 600 clamp(2rem, 4.4vw, 4rem)/1 var(--mono); letter-spacing: -0.04em; font-variant-numeric: tabular-nums; }
  .cap { font-size: .8125rem; color: var(--ink-2); }
  @media (max-width: 860px) {
    .proof { grid-template-columns: 1fr 1fr; }
    .stat, .stat + .stat { padding: 24px 12px; border-left: 0; }
    .stat:nth-child(even) { border-left: 1px solid var(--rule); }
    .stat:nth-child(-n+2) { border-bottom: 1px solid var(--rule); }
  }

  .spread { display: grid; grid-template-columns: 1.6fr 1fr; gap: 20px; }
  @media (max-width: 860px) { .spread { grid-template-columns: 1fr; } }
  .lead, .short { background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 28px; }
  .shorts { display: grid; gap: 20px; }
  .row-top { margin-bottom: 14px; }
  .lead h3 { font: 700 clamp(1.5rem, 2.6vw, 2.125rem)/1.15 var(--display); margin: 0 0 20px; letter-spacing: -0.015em; }
  .short h3 { font: 700 1.25rem/1.25 var(--display); margin: 0 0 10px; }
  .short p { margin: 0; color: var(--ink-2); font-size: 1rem; }
  dl { display: grid; grid-template-columns: 110px 1fr; gap: 12px 20px; margin: 0; }
  dt { font: 500 .75rem/1.9 var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--accent); }
  dd { margin: 0; }
  @media (max-width: 560px) { dl { grid-template-columns: 1fr; gap: 4px; } dd { margin-bottom: 10px; } }

  .ledger { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .ledger li { display: grid; grid-template-columns: minmax(180px, 280px) 1fr; gap: 28px; padding: 28px 12px; border-bottom: 1px solid var(--rule); }
  .lnum { font: 600 clamp(2.25rem, 5vw, 4.5rem)/1 var(--mono); letter-spacing: -0.04em; }
  .dash { color: var(--ink-2); }
  .ledger h3 { font: 700 1.375rem/1.25 var(--display); margin: 0 0 6px; }
  .ledger p { margin: 0 0 6px; color: var(--ink-2); max-width: 68ch; }
  .ledger .note { color: var(--accent); font: 500 .9375rem var(--mono); }
  @media (max-width: 720px) { .ledger li { grid-template-columns: 1fr; gap: 10px; } }
  .awards { margin: 24px 0 0; font: .875rem var(--mono); color: var(--ink-2); }

  .index { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .qrow { border-bottom: 1px solid var(--rule); }
  .qlink { display: grid; grid-template-columns: 64px 1fr auto; gap: 20px; align-items: start; padding: 24px 12px; text-decoration: none; }
  .featured .qlink { padding: 32px 12px; }
  .qcode { font: 500 .8125rem/2.2 var(--mono); color: var(--accent); }
  .qmain { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .qtitle { font: 700 clamp(1.375rem, 2.6vw, 2rem)/1.15 var(--display); letter-spacing: -0.015em; }
  .qhead { font-size: 1.0625rem; }
  .qlim, .qboss { font-size: .9375rem; color: var(--ink-2); }
  .qside { display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .qdate { font: .8125rem var(--mono); color: var(--ink-2); white-space: nowrap; }
  .arrow { font-size: 1.5rem; color: var(--accent); transition: transform .2s; }
  .qlink:hover .arrow, .qlink:focus-visible .arrow { transform: translateX(6px); }
  .qlink:hover .qtitle { color: var(--accent); }
  @media (max-width: 720px) {
    .qlink { grid-template-columns: 1fr; gap: 8px; }
    .qside { flex-direction: row; align-items: center; justify-content: flex-start; }
  }
  .chip { display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 6px; border: 1px solid var(--rule); font: 500 .75rem var(--mono); color: var(--ink); background: var(--surface); white-space: nowrap; }

  .method { padding-top: 112px; padding-bottom: 112px; }
  .method h2, .contact h2 { font: 700 clamp(1.75rem, 3.5vw, 3rem)/1.1 var(--display); margin: 10px 0 12px; letter-spacing: -0.02em; }
  .hud { font: 600 .8125rem var(--mono); letter-spacing: .06em; margin: 0 0 28px; background: var(--spectrum); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .grid { width: 100%; border-collapse: collapse; font-size: .9375rem; }
  .grid th, .grid td { text-align: left; padding: 14px 12px; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .grid thead th { font: 500 .75rem var(--mono); letter-spacing: .06em; text-transform: uppercase; color: var(--ink-2); }
  .grid tbody th { font: 600 1rem var(--display); }
  .grid tbody th a { text-decoration: none; }
  .grid td.lit { font-family: var(--mono); font-size: .875rem; }
  .grid td.lit::before { content: '●'; color: var(--oss); margin-right: 8px; font-size: .75em; }
  .grid td.empty { color: var(--ink-2); }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .grid td.lit::before { animation: lightup linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; }
    }
  }
  @keyframes lightup { from { color: var(--rule); } to { color: var(--oss); } }
  @media (max-width: 860px) {
    .grid thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .grid tr { display: block; padding: 16px 0; border-bottom: 1px solid var(--rule); }
    .grid th, .grid td { display: block; border: 0; padding: 4px 0; }
    .grid td::after { content: ' · ' attr(data-label); color: var(--ink-2); font-family: var(--body); font-size: .8125rem; }
  }

  .last { color: var(--accent); margin-bottom: 18px; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .log a { display: grid; grid-template-columns: 120px 1fr auto; gap: 20px; padding: 24px; border-radius: 6px; background: var(--surface); border: 1px solid var(--rule); text-decoration: none; }
  .log a:hover { border-color: var(--accent); }
  .ldate { font: .8125rem/1.8 var(--mono); color: var(--accent); }
  .lbody { display: flex; flex-direction: column; gap: 6px; }
  .lbody strong { font: 700 1.25rem/1.25 var(--display); }
  .lmodel { font: .8125rem var(--mono); color: var(--ink-2); }
  @media (max-width: 720px) { .log a { grid-template-columns: 1fr; gap: 8px; } }
  .tracking { margin-top: 18px; font-size: .9375rem; color: var(--ink-2); }
  .tracking summary { cursor: pointer; font: 500 .8125rem var(--mono); text-transform: uppercase; letter-spacing: .08em; color: var(--ink); min-height: 32px; }

  .caps { padding-top: 112px; padding-bottom: 40px; }
  .caps ul { list-style: none; margin: 18px 0 0; padding: 0; }
  .caps li { display: grid; grid-template-columns: minmax(240px, 1fr) 1.4fr; gap: 24px; padding: 20px 0; border-bottom: 1px solid var(--rule); align-items: baseline; }
  .cname { font: 700 clamp(1.25rem, 2.2vw, 1.75rem)/1.2 var(--display); }
  .cdetail { color: var(--ink-2); }
  @media (max-width: 720px) { .caps li { grid-template-columns: 1fr; gap: 6px; } }

  .contact { padding-top: 112px; padding-bottom: 96px; }
  .about { margin-top: 64px; max-width: 72ch; }
  .about h3 { font: 500 .75rem var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .about p { font-size: 1.125rem; }
</style>

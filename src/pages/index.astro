---
import { getCollection } from 'astro:content'
import Base from '../layouts/Base.astro'
import { profile } from '../data/profile'
import { sortQuests } from '../lib/achievements'

const quests = sortQuests(await getCollection('quests'))
// Resolved from the project root by Vite, so it works whatever directory the build runs from.
const POSTERS = Object.keys(import.meta.glob('/public/demos/*.jpg'))
const poster = (id: string) => (POSTERS.includes(`/public/demos/${id}.jpg`) ? `/demos/${id}.jpg` : null)
const [nextLabel, ...nextRest] = profile.next.split(': ')
const SECTIONS = [
  { id: 'about', label: 'About' },
  { id: 'experience', label: 'Experience' },
  { id: 'open-source', label: 'Open source' },
  { id: 'awards', label: 'Awards & education' },
]
---
<Base title={`${profile.name}, Forward Deployed Engineer`} description={profile.description} home>
  <div class="wrap page">
    <header class="side">
      <div>
        <h1 class="name"><a href="/">{profile.name}</a></h1>
        <p class="role">{profile.role}<span class="loc"> · {profile.location}</span></p>
        <p class="intro">{profile.intro}</p>
        <p class="next"><span>{nextLabel}:</span> {nextRest.join(': ')}</p>
        <ul class="links" aria-label="Links">
          <li><a href={profile.resume}>Résumé</a></li>
          <li><a href={`mailto:${profile.email}`}>Email</a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn<span class="ext" aria-hidden="true">↗</span></a></li>
          <li><a href={profile.github} target="_blank" rel="noopener">GitHub<span class="ext" aria-hidden="true">↗</span></a></li>
        </ul>
        <nav class="nav" aria-label="Sections">
          <ul>
            {SECTIONS.map(s => (
              <li><a href={`#${s.id}`}><span class="ind" aria-hidden="true"></span><span class="lbl">{s.label}</span></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="content" class="content">
      <section id="about" aria-label="About">
        <h2 class="label">About</h2>
        <div class="prose">{profile.about.map(p => <p>{p}</p>)}</div>
      </section>

      <section id="experience" aria-label="Experience">
        <h2 class="label">Experience</h2>
        <ol class="rows">
          {profile.experience.map(e => (
            <li class="row">
              <p class="when">{e.when}</p>
              <div class="body">
                <h3><a class="title" href={`${profile.resume}#${e.id}`}>{e.title} · {e.org}<span class="ext" aria-hidden="true">→</span></a></h3>
                <p class="line">{e.line}</p>
                <ul class="tags" aria-label="Technologies">{e.tags.map(t => <li>{t}</li>)}</ul>
              </div>
            </li>
          ))}
        </ol>
        <a class="more" href={profile.resume}>View full résumé <span aria-hidden="true">→</span></a>
      </section>

      <section id="open-source" aria-label="Open source">
        <h2 class="label">Open source</h2>
        <ol class="rows">
          {quests.map(q => {
            const img = poster(q.id)
            const href = q.data.repo ? `https://github.com/${q.data.repo}` : '/log/#2026-10-30-d1-3b'
            const external = !!q.data.repo
            return (
              <li class="row">
                {img && <div class="media"><img class="thumb" src={img} alt="" width="960" height="600" loading="lazy" decoding="async" /></div>}
                <div class="body">
                  <h3><a class="title" href={href} {...(external ? { target: '_blank', rel: 'noopener' } : {})}>{q.data.title}{q.data.status === 'in-progress' && <span class="wip">in progress</span>}<span class="ext" aria-hidden="true">{external ? '↗' : '→'}</span></a></h3>
                  <p class="line">{q.data.line}</p>
                  <ul class="tags" aria-label="Technologies">{q.data.stack.slice(0, 4).map(t => <li>{t}</li>)}</ul>
                </div>
              </li>
            )
          })}
        </ol>
        <a class="more" href={profile.github} target="_blank" rel="noopener">All repositories on GitHub <span aria-hidden="true">↗</span></a>
      </section>

      <section id="awards" aria-label="Awards and education">
        <h2 class="label">Awards & education</h2>
        <ol class="rows">
          {profile.awards.map(a => (
            <li class={`row ${'image' in a ? 'with-img' : ''}`}>
              {'image' in a && a.image ? (
                <div class="media">
                  <p class="when">{a.when}</p>
                  <a class="photo" href={a.image.src} target="_blank" rel="noopener" aria-label={`Open photo: ${a.title}`}>
                    <img class="thumb natural" src={'thumb' in a.image ? a.image.thumb : a.image.src} alt={a.image.alt} width={a.image.w} height={a.image.h} loading="lazy" decoding="async" />
                  </a>
                </div>
              ) : <p class="when">{a.when}</p>}
              <div class="body">
                <h3 class="plain">{a.title}</h3>
                <p class="line">{a.line}</p>
              </div>
            </li>
          ))}
          {profile.education.map(e => (
            <li class="row">
              <p class="when">{e.when}</p>
              <div class="body">
                <h3 class="plain">{e.org}</h3>
                <p class="deg">{e.title}</p>
                {'line' in e && <p class="line">{e.line}</p>}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <footer class="foot">
        <p>{profile.footer}</p>
        <p><a class="mail" href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <ul class="links small" aria-label="Links">
          <li><a href={profile.resume}>Résumé</a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener">LinkedIn<span class="ext" aria-hidden="true">↗</span></a></li>
          <li><a href={profile.github} target="_blank" rel="noopener">GitHub<span class="ext" aria-hidden="true">↗</span></a></li>
        </ul>
      </footer>
    </main>
  </div>
</Base>

<script>
  // Scroll-spy: the nav item for the section in the top 30% of the viewport is active;
  // at the very bottom the last item wins (a short last section would otherwise never light up).
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.nav a')]
  const ids = links.map(a => a.hash.slice(1))
  const set = (id: string) => links.forEach(a => a.classList.toggle('active', a.hash === `#${id}`))
  const io = new IntersectionObserver(es => es.forEach(e => e.isIntersecting && set(e.target.id)), { rootMargin: '0px 0px -70% 0px' })
  ids.forEach(id => { const el = document.getElementById(id); if (el) io.observe(el) })
  addEventListener('scroll', () => {
    if (innerHeight + scrollY >= document.documentElement.scrollHeight - 4) set(ids.at(-1)!)
  }, { passive: true })
  set(ids[0]!)
</script>

<style>
  /* ── Layout: single column on phones; sticky identity column + scrolling content from 1024px ── */
  .side { padding-top: 64px; }
  .content { padding: 48px 0 64px; }
  @media (min-width: 1024px) {
    .page { display: flex; justify-content: space-between; gap: 16px; }
    .side { position: sticky; top: 0; max-height: 100vh; width: 48%; display: flex; flex-direction: column; justify-content: space-between; padding: 96px 0; }
    .content { width: 52%; padding: 96px 0; }
  }
  /* Short laptop screens (1366×768 leaves ~657px): tighten so the column still fits; un-stick only below that. */
  @media (min-width: 1024px) and (max-height: 700px) { .side { padding: 48px 0; } .nav { margin-top: 32px; } }
  @media (min-width: 1024px) and (max-height: 560px) { .side { position: static; max-height: none; } }

  /* ── Identity ── */
  .name { font: 600 clamp(2.5rem, 5vw, 3.25rem)/1.05 var(--sans); letter-spacing: -0.035em; }
  .name a { color: var(--ink); }
  .role { margin-top: 12px; color: var(--ink); font-size: 1.125rem; font-weight: 500; letter-spacing: -0.01em; text-wrap: balance; }
  .intro { margin-top: 16px; max-width: 340px; }
  .next { margin-top: 16px; max-width: 340px; font-size: .9375rem; }
  .next span { color: var(--ink); font-weight: 500; }
  .links { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 22px; }
  .links a { display: inline-flex; align-items: center; min-height: 44px; color: var(--ink); font-weight: 500; text-decoration: underline; text-decoration-color: transparent; text-underline-offset: 5px; transition: text-decoration-color .2s var(--ease); }
  .ext { display: inline-block; margin-left: 3px; font-size: .85em; transition: transform .15s var(--ease); }
  @media (hover: hover) {
    .links a:hover { text-decoration-color: var(--ink-3); }
    .links a:hover .ext { transform: translate(2px, -2px); }
  }

  /* ── Section nav (desktop only) ── */
  .nav { display: none; }
  @media (min-width: 1024px) {
    .nav { display: block; margin-top: 64px; }
    .nav ul { list-style: none; margin: 0; padding: 0; width: max-content; }
    .nav a { display: flex; align-items: center; gap: 16px; padding: 12px 0; }
    .ind { width: 32px; height: 1px; background: var(--ink-3); transition: width .15s var(--ease), background .15s var(--ease); }
    .lbl { font: 500 .75rem/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); transition: color .15s var(--ease); }
    .nav a.active .ind { width: 64px; background: var(--chroma); }
    .nav a.active .lbl { color: var(--ink); }
  }
  @media (min-width: 1024px) and (hover: hover) {
    .nav a:hover .ind { width: 64px; background: var(--ink); }
    .nav a:hover .lbl { color: var(--ink); }
  }

  /* ── Sections ── */
  section { margin-bottom: 64px; scroll-margin-top: 96px; }
  @media (min-width: 768px) { section { margin-bottom: 96px; } }
  @media (min-width: 1024px) { section { margin-bottom: 144px; scroll-margin-top: 96px; } }
  /* Section labels: a sticky blurred bar on phones; hidden on desktop, where the nav names them. */
  .label { position: sticky; top: 0; z-index: 20; margin: 0 -24px 16px; padding: 18px 24px; font: 500 .75rem/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--ink); background: color-mix(in oklch, var(--bg) 78%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  @media (min-width: 768px) { .label { margin: 0 -48px 16px; padding: 18px 48px; } }
  @media (min-width: 1024px) { .label { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } }
  .prose p + p { margin-top: 16px; }

  /* ── Rows: date gutter + body; whole row clickable; hovering one dims the others ── */
  .rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 48px; }
  .row { position: relative; isolation: isolate; display: grid; gap: 8px; transition: opacity .15s var(--ease); }
  @media (min-width: 640px) { .row { grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 16px; } .row > .when, .row > .media { grid-column: 1 / span 2; } .row > .body { grid-column: 3 / -1; } }
  .row::before { content: ''; position: absolute; inset: -16px -24px; z-index: -1; border-radius: 10px; transition: background .15s var(--ease), box-shadow .15s var(--ease); }
  @media (min-width: 1024px) and (hover: hover) {
    .rows:has(> .row:hover .title) > .row:not(:hover) { opacity: .5; }
    .row::after { content: ''; position: absolute; inset: -24px 0; z-index: -2; }
    .row:has(.title):hover::before { background: color-mix(in oklch, var(--surface-2) 70%, transparent); box-shadow: inset 0 1px 0 rgb(255 255 255 / .05); }
    .row:hover .title { color: var(--c1); }
    .row:hover .title .ext { transform: translate(2px, -2px); }
  }
  .when { font: 500 .75rem/1.6 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); padding-top: 3px; text-wrap: balance; }
  .body h3 { font-size: 1rem; line-height: 1.4; font-weight: 500; }
  .title { color: var(--ink); transition: color .15s var(--ease); }
  /* The title link covers the whole row. */
  .title::after { content: ''; position: absolute; inset: -16px -24px; z-index: 1; border-radius: 10px; }
  .wip { margin-left: 8px; font: 500 .6875rem/1 var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); padding: 3px 8px; border: 1px solid var(--rule); border-radius: 999px; vertical-align: 2px; }
  .line { margin-top: 8px; font-size: .9375rem; line-height: 1.6; }
  .deg { margin-top: 4px; color: var(--ink); font-size: .9375rem; }
  .tags { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font: 500 .75rem/1 var(--sans); color: var(--ink-2); padding: 6px 11px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--rule); }

  /* Thumbnails: small, quiet, never cropped awkwardly; photos keep their natural ratio. */
  .media { order: 2; max-width: 200px; }
  @media (min-width: 640px) { .media { order: 0; max-width: none; padding-top: 4px; } .with-img .media { padding-top: 0; } .with-img .photo { display: block; margin-top: 8px; } }
  /* Phones: the award date stays first, the photo goes last, like every other row. */
  @media (max-width: 639px) { .with-img > .media { display: contents; } .with-img > .media > .when { order: -1; } .with-img .photo { order: 2; display: block; max-width: 200px; } }
  .thumb { display: block; width: 100%; height: auto; object-fit: cover; border-radius: 6px; border: 1px solid var(--rule); transition: border-color .15s var(--ease); }
  .thumb:not(.natural) { aspect-ratio: 16 / 10; }
  .photo { position: relative; z-index: 2; }
  @media (hover: hover) { .row:hover .thumb, .photo:hover .thumb { border-color: color-mix(in oklch, var(--ink) 25%, transparent); } }

  .more { display: inline-flex; align-items: center; gap: 6px; margin-top: 40px; min-height: 44px; color: var(--ink); font-weight: 500; }
  .more span { transition: transform .15s var(--ease); }
  @media (hover: hover) { .more:hover span { transform: translateX(4px); } .more:hover { color: var(--c1); } }

  /* ── Footer ── */
  .foot { padding-top: 32px; border-top: 1px solid var(--rule); font-size: .875rem; color: var(--ink-3); }
  .foot p + p { margin-top: 4px; }
  .mail { color: var(--ink); display: inline-flex; align-items: center; min-height: 44px; }
  .links.small { margin-top: 4px; }
  .links.small a { font-size: .875rem; }

  /* ── One quiet entrance, CSS only; content is in the HTML regardless ── */
  @media (prefers-reduced-motion: no-preference) {
    .side > div > *, .content { animation: rise .6s var(--ease) backwards; }
    .side > div > :nth-child(2) { animation-delay: .05s; }
    .side > div > :nth-child(3) { animation-delay: .1s; }
    .side > div > :nth-child(4) { animation-delay: .15s; }
    .side > div > :nth-child(5) { animation-delay: .2s; }
    .side > div > :nth-child(6), .content { animation-delay: .25s; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(8px); } }
</style>

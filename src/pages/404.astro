---
import Base from '../layouts/Base.astro'
import { profile } from '../data/profile'
---
<Base title={`Not found · ${profile.name}`} description="This page doesn't exist.">
  <section class="wrap nf">
    <p class="code">404</p>
    <h1>This page doesn’t exist.</h1>
    <p><a href="/">Go to the home page</a> or email <a href={`mailto:${profile.email}`}>{profile.email}</a>.</p>
  </section>
</Base>

<style>
  .nf { padding-top: 64px; padding-bottom: 120px; }
  .code { font: 500 .75rem var(--mono); letter-spacing: .14em; color: var(--ink-3); }
  h1 { font-size: clamp(2rem, 5vw, 2.75rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; margin: 12px 0 16px; }
  a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--ink-3); text-underline-offset: 5px; }
</style>

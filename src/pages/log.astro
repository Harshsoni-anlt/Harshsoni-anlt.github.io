---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { fmtDate } from '../lib/achievements'

const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date)
const entries = await Promise.all(logs.map(async l => ({ l, Content: (await render(l)).Content })))
---
<Base title="Frontier field log · Harsh Soni" description="New AI models and techniques, tested on real data. What held up, with numbers.">
  <div>
    <header class="wrap head">
      <p class="code">Field log</p>
      <h1>What I’m testing now</h1>
      <p class="lede">New models ship weekly. Each entry is one thing tested on real data, with the numbers, the caveats and what it means for a real deployment.</p>
    </header>
    <ol class="wrap entries">
      {entries.map(({ l, Content }) => (
        <li id={l.id} class="entry">
          <p class="meta"><span class="date">{fmtDate(l.data.date)}</span>{l.data.tag && <span class="chip">{l.data.tag}</span>}{l.data.kind === 'tracking' && <span class="chip">Tracking</span>}</p>
          <h2>{l.data.title}</h2>
          {l.data.model && <p class="model">{l.data.model}</p>}
          <p class="result">{l.data.result}</p>
          <div class="prose"><Content /></div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .head { padding-top: 32px; padding-bottom: 16px; max-width: 760px; }
  .code { font: 500 .75rem var(--mono); letter-spacing: .14em; text-transform: uppercase; color: var(--ink-3); }
  h1 { font-size: clamp(2rem, 5vw, 2.75rem); line-height: 1.1; font-weight: 600; letter-spacing: -0.03em; margin: 12px 0; }
  .lede { max-width: 62ch; }
  .entries { list-style: none; max-width: 760px; padding-top: 16px; padding-bottom: 96px; }
  .entry { padding: 32px 0; border-top: 1px solid var(--rule); scroll-margin-top: 24px; }
  .meta { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 10px; }
  .date { font: 500 .75rem var(--mono); letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }
  .chip { font: 500 .75rem/1 var(--sans); color: var(--ink); padding: 6px 11px; border-radius: 999px; background: var(--surface-2); border: 1px solid var(--rule); }
  h2 { font-size: 1.375rem; line-height: 1.3; font-weight: 600; letter-spacing: -0.015em; margin-bottom: 6px; }
  .model { font: .8125rem var(--mono); color: var(--ink-3); margin-bottom: 12px; }
  .result { color: var(--ink); margin-bottom: 16px; }
  .prose :global(p) { max-width: 72ch; }
  .prose :global(p + p) { margin-top: 12px; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: .9375rem; margin: 16px 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  @media (max-width: 639px) { .prose :global(th), .prose :global(td) { white-space: normal; padding: 10px 8px; } }
  :global(.sub) { max-width: 760px; }
  .prose :global(th) { font: 500 .75rem var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-3); }
  .prose :global(strong) { color: var(--ink); font-weight: 500; }
</style>

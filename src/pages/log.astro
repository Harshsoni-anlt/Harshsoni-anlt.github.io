---
import { getCollection, render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { fmtDate } from '../lib/achievements'

const logs = (await getCollection('log')).sort((a, b) => +b.data.date - +a.data.date)
const entries = await Promise.all(logs.map(async l => ({ l, Content: (await render(l)).Content })))
---
<Base title="Frontier field log · Harsh Soni" description="New AI models and techniques, tested on real data. What held up, with numbers.">
  <div data-chapter="frontier">
    <header class="wrap head">
      <p class="eyebrow">Ch.04 · Frontier field log</p>
      <h1>What I’m testing now</h1>
      <p class="lede">New models ship weekly. Each entry is one thing tested on real data, with the numbers, the caveats and what it means for a real deployment.</p>
    </header>
    <ol class="wrap entries">
      {entries.map(({ l, Content }) => (
        <li id={l.id} class="entry reveal">
          <p class="meta"><span class="date">{fmtDate(l.data.date)}</span>{l.data.tag && <span class="chip">{l.data.tag}</span>}{l.data.kind === 'tracking' && <span class="chip">Tracking</span>}</p>
          <h2>{l.data.title}</h2>
          {l.data.model && <p class="model">{l.data.model}</p>}
          <p class="result">{l.data.result}</p>
          <div class="prose"><Content /></div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .head { padding-top: 64px; padding-bottom: 32px; }
  .head .eyebrow { color: var(--accent); }
  h1 { font: 750 clamp(2.25rem, 6vw, 4.5rem)/1.02 var(--display); letter-spacing: -0.03em; margin: 12px 0; }
  .lede { font-size: 1.1875rem; color: var(--ink-2); max-width: 62ch; margin: 0; }
  .entries { list-style: none; padding-top: 16px; padding-bottom: 72px; margin: 0 auto; }
  .entry { padding: 32px 0; border-top: 3px solid var(--accent); margin-bottom: 24px; max-width: 900px; }
  .meta { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin: 0 0 10px; }
  .date { font: .8125rem var(--mono); color: var(--accent); }
  .chip { display: inline-flex; align-items: center; height: 24px; padding: 0 9px; border-radius: 6px; border: 1px solid var(--rule); font: 500 .75rem var(--mono); background: var(--surface); }
  h2 { font: 700 clamp(1.5rem, 3vw, 2.25rem)/1.15 var(--display); margin: 0 0 6px; }
  .model { font: .875rem var(--mono); color: var(--ink-2); margin: 0 0 12px; }
  .result { font-size: 1.125rem; margin: 0 0 18px; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: .9375rem; margin: 18px 0; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--rule); white-space: nowrap; }
  .prose :global(th) { font: 500 .75rem var(--mono); text-transform: uppercase; letter-spacing: .06em; color: var(--ink-2); }
  .prose :global(p) { max-width: 72ch; }
</style>
